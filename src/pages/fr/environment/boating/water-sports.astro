---
import Page from '@/layouts/Page.astro';
import { loadContentPage } from '@/utils/loadContentPage';

const page = await loadContentPage('fr', 'environment/boating/water-sports');
const title = page.frontmatter?.title ?? "Sécurité de la navigation et des sports nautiques";
const description = page.frontmatter?.description;
---

<Page title={title} description={description} content={page} section="environment" />
