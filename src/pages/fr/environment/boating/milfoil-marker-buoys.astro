---
import Page from '@/layouts/Page.astro';
import { loadContentPage } from '@/utils/loadContentPage';

const page = await loadContentPage('fr', 'environment/boating/milfoil-marker-buoys');
const title = page.frontmatter?.title ?? "Bouées marqueurs de myriophylle à épi eurasien";
const description = page.frontmatter?.description;
---

<Page title={title} description={description} content={page} section="environment" />
