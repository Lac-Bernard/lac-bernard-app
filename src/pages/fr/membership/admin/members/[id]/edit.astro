---
export const prerender = false;

import AdminMemberEditView from '../../../../../../components/members/AdminMemberEditView.astro';
import { createSupabasePageClient } from '../../../../../../lib/supabase/server';
import { isAppAdmin } from '../../../../../../lib/auth/admin';
import { memberPaths } from '../../../../../../lib/members/i18n';

const paths = memberPaths.fr;
const { supabase, flushCookies, redirectWithCookies } = createSupabasePageClient(
	Astro.request,
	Astro.cookies,
);
const {
	data: { user },
	error,
} = await supabase.auth.getUser();

if (error || !user) {
	return redirectWithCookies(`${paths.signIn}?next=${encodeURIComponent(Astro.url.pathname)}`);
}

if (!isAppAdmin(user)) {
	return redirectWithCookies(paths.account);
}

flushCookies();

const id = Astro.params.id;
if (!id) {
	return redirectWithCookies(paths.admin);
}

const origin = Astro.url.origin;
const res = await fetch(`${origin}/api/admin/members/${encodeURIComponent(id)}`, {
	headers: { Cookie: Astro.request.headers.get('cookie') ?? '' },
});
if (!res.ok) {
	return Astro.redirect(`${paths.admin}?tab=members`);
}
const payload = (await res.json()) as { member?: Record<string, unknown> };
if (!payload.member) {
	return Astro.redirect(`${paths.admin}?tab=members`);
}

const email = user.email ?? '';
---

<AdminMemberEditView locale="fr" email={email} memberId={id} member={payload.member} />
