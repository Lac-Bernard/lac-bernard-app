---
export const prerender = false;

import AdminMemberDetailView from '../../../../../components/members/AdminMemberDetailView.astro';
import { createSupabasePageClient } from '../../../../../lib/supabase/server';
import { isAppAdmin } from '../../../../../lib/auth/admin';
import { memberPaths } from '../../../../../lib/members/i18n';
import { formatMemberPrimaryName } from '../../../../../lib/members/memberDisplayName';

const paths = memberPaths.fr;
const { supabase, flushCookies, redirectWithCookies } = createSupabasePageClient(
	Astro.request,
	Astro.cookies,
);
const {
	data: { user },
	error,
} = await supabase.auth.getUser();

if (error || !user) {
	return redirectWithCookies(`${paths.signIn}?next=${encodeURIComponent(Astro.url.pathname)}`);
}

if (!isAppAdmin(user)) {
	return redirectWithCookies(paths.account);
}

flushCookies();

const id = Astro.params.id;
if (!id) {
	return redirectWithCookies(paths.admin);
}

const origin = Astro.url.origin;
const memberRes = await fetch(`${origin}/api/admin/members/${encodeURIComponent(id)}`, {
	headers: { Cookie: Astro.request.headers.get('cookie') ?? '' },
});
if (!memberRes.ok) {
	return Astro.redirect(`${paths.admin}?tab=members`);
}
const memberPayload = (await memberRes.json()) as { member?: Record<string, unknown> };
const m = memberPayload.member;
if (!m) {
	return Astro.redirect(`${paths.admin}?tab=members`);
}
const memberPageTitle = formatMemberPrimaryName({
	first_name: typeof m.first_name === 'string' ? m.first_name : null,
	last_name: typeof m.last_name === 'string' ? m.last_name : '—',
});

const email = user.email ?? '';
---

<AdminMemberDetailView locale="fr" email={email} memberId={id} memberPageTitle={memberPageTitle} />
