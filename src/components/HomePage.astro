---
import '../styles/theme.css';
import '../styles/components.css';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import type { Language } from '@/utils/i18n';
import { blogPostSlug } from '@/utils/blog';
import { getCollection } from 'astro:content';
import FormattedDate from '@/components/FormattedDate.astro';
import { loadContentPage } from '@/utils/loadContentPage';
import { homeUi } from '@/i18n/home';

interface Props {
	lang: Language;
}

const { lang } = Astro.props;
const ui = homeUi[lang];

const home = await loadContentPage(lang, 'home');
const { Content, frontmatter } = home;

const fm = frontmatter as { heroTitle?: string; heroSubtitle?: string } | undefined;
const heroTitle = fm?.heroTitle ?? ui.defaultHeroTitle;
const heroSubtitleCustom = fm?.heroSubtitle?.trim() ?? '';
const membershipPath = `/${lang}/membership`;
const newsArchivePath = `/${lang}/news/`;

const allPosts = await getCollection('blog');
const latestPosts = allPosts
	.filter((post) => post.id.startsWith(`${lang}/`))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const newsHeroHref = latestPosts.length > 0 ? '#latest-news' : newsArchivePath;

const title = ui.siteTitle;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={ui.metaDescription} />
  </head>

  <body>
    <SiteHeader />

    <main id="main-content">
      <section class="hero" aria-label={ui.heroAriaLabel}>
        <div class="container heroInner">
          <div class="heroCopy">
            <p class="kicker">{ui.heroKicker}</p>
            <h1>{heroTitle}</h1>
            {heroSubtitleCustom ? (
              <p class="subtitle" set:html={heroSubtitleCustom} />
            ) : (
              <p class="subtitle">{ui.heroTagline}</p>
            )}
            <div class="heroActions">
              <a href={membershipPath} class="btnPrimary heroPrimaryBtn">{ui.ctaMembership}</a>
              <a href={newsHeroHref} class="btnGhost heroSecondaryBtn">{ui.ctaNews}</a>
            </div>
          </div>
        </div>
      </section>

      <section class="section homeIntro">
        <div class="container">
          <div class="homeReadingColumn prose">
            <Content />
          </div>
        </div>
      </section>

      <section class="section stats">
        <div class="container">
          <div class="statsGrid">
            <div class="stat"><div class="num">92</div><div class="label">{ui.years}</div></div>
            <div class="stat"><div class="num">200+</div><div class="label">{ui.members}</div></div>
            <div class="stat"><div class="num">3+</div><div class="label">{ui.events}</div></div>
            <div class="stat"><div class="num">100%</div><div class="label">{ui.volunteerRun}</div></div>
          </div>
        </div>
      </section>

      {latestPosts.length > 0 && (
        <section class="section alt homeLatestNews" id="latest-news" aria-labelledby="home-latest-news-heading">
          <div class="container">
            <div class="homeReadingColumn">
              <h2 id="home-latest-news-heading" class="homeLatestNews-heading">{ui.latestNews}</h2>
              <ul class="newsList">
                {latestPosts.map((post) => (
                  <li>
                    <a class="newsTeaser" href={`/${lang}/news/${blogPostSlug(post.id)}/`}>
                      <h3 class="newsTeaser-title">{post.data.title}</h3>
                      <p class="newsTeaser-meta">
                        <FormattedDate date={post.data.pubDate} lang={lang} />
                      </p>
                      <p class="newsTeaser-excerpt">{post.data.description}</p>
                      <span class="newsTeaser-cta">
                        {ui.readMore}
                        <span class="newsTeaser-ctaArrow" aria-hidden="true">→</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      )}

      <section class="section land">
        <div class="container">
          <div class="homeReadingColumn homeLandAck">
            <h2>{ui.landAck}</h2>
            <p>{ui.landAckText}</p>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />

    <style>
      /* Page-specific styles for homepage */
      .hero {
        min-height: min(78vh, 720px);
        display: flex;
        align-items: center;
        padding: 96px 0 88px;
        position: relative;
        background-color: #0f2433;
        background-image: url('/images/home-hero-lake-rainbow.jpg');
        background-size: cover;
        background-position: center 38%;
        background-repeat: no-repeat;
        color: white;
      }

      .hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(
          180deg,
          rgba(8, 18, 28, 0.42) 0%,
          rgba(8, 18, 28, 0.18) 42%,
          rgba(6, 14, 22, 0.72) 100%
        );
        z-index: 0;
      }

      .hero .container {
        position: relative;
        z-index: 1;
      }

      .heroInner {
        display: block;
      }

      .heroCopy {
        color: white;
      }

      .kicker {
        margin: 0 0 12px;
        color: rgba(255, 255, 255, 0.8);
        font-size: 16px;
        letter-spacing: .14em;
        text-transform: uppercase;
      }

      .hero h1 {
        margin: 0 0 18px;
        font-size: clamp(40px, 5vw, 64px);
        line-height: 1.06;
        letter-spacing: -.03em;
        color: white;
      }

      .hero .subtitle {
        margin: 0 0 28px;
        max-width: 40rem;
        color: rgba(255, 255, 255, 0.92);
        font-size: clamp(18px, 2.2vw, 22px);
        line-height: 1.45;
      }

      .heroActions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
      }

      .heroPrimaryBtn {
        box-shadow: 0 2px 14px rgba(0, 0, 0, 0.25);
      }

      .hero .heroSecondaryBtn {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.55);
        color: white;
      }

      .hero .heroSecondaryBtn:hover {
        background: rgba(255, 255, 255, 0.18);
        border-color: rgba(255, 255, 255, 0.75);
        color: white;
      }

      .hero .heroSecondaryBtn:focus-visible {
        outline-color: rgba(255, 255, 255, 0.85);
      }

      /**
       * Comfortable reading measure (~65–72ch), centered so headings and body share one column.
       */
      .homeReadingColumn {
        max-width: min(44rem, 100%);
        margin-inline: auto;
        width: 100%;
      }

      .homeIntro :global(.prose > p:first-of-type) {
        font-size: clamp(1.05rem, 0.6vw + 1rem, 1.28rem);
        line-height: 1.55;
        color: var(--text);
      }

      .homeIntro :global(.prose h2:first-of-type) {
        margin-top: 2.25rem;
      }

      .prose .btnPrimary {
        margin-top: 20px;
        display: inline-block;
      }

      .stats {
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        background: rgba(0, 0, 0, 0.02);
      }

      .land {
        background: rgba(0,0,0,.03);
        text-align: center;
      }

      .homeLandAck {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
      }

      .homeLandAck h2 {
        margin: 0;
        font-size: 28px;
      }

      .homeLandAck p {
        margin: 0;
        color: var(--muted);
        font-size: 19px;
      }

      .homeLatestNews-heading {
        margin: 0 0 1.75rem;
        font-size: clamp(1.5rem, 2.5vw, 1.875rem);
        font-weight: 650;
        letter-spacing: -0.02em;
        line-height: 1.2;
      }

      .newsList {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .newsList li {
        margin: 0;
      }

      .newsTeaser {
        --news-link: #1d4ed8;
        --news-link-dim: rgba(29, 78, 216, 0.4);
        display: block;
        text-decoration: none;
        color: inherit;
        padding: 1.625rem 1rem;
        margin: 0 -1rem;
        border-radius: 12px;
        border-bottom: 1px solid var(--border);
        transition: background-color 0.15s ease;
      }

      .newsList li:last-child .newsTeaser {
        border-bottom: none;
      }

      .newsTeaser:hover {
        background: rgba(0, 0, 0, 0.035);
      }

      .newsTeaser:focus-visible {
        outline: 2px solid var(--news-link);
        outline-offset: 2px;
      }

      .newsTeaser:hover .newsTeaser-title {
        color: var(--news-link);
      }

      .newsTeaser-title {
        margin: 0 0 0.5rem;
        font-size: clamp(1.125rem, 1.5vw, 1.3125rem);
        font-weight: 650;
        line-height: 1.3;
        letter-spacing: -0.02em;
        color: var(--text);
        transition: color 0.15s ease;
      }

      .newsTeaser-meta {
        margin: 0 0 1rem;
        font-size: 0.8125rem;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .newsTeaser-meta :global(time) {
        color: inherit;
      }

      .newsTeaser-excerpt {
        margin: 0 0 1.125rem;
        font-size: 1.0625rem;
        line-height: 1.55;
        color: rgba(0, 0, 0, 0.78);
      }

      .newsTeaser-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.9375rem;
        font-weight: 600;
        color: var(--news-link);
        text-decoration: underline;
        text-decoration-color: var(--news-link-dim);
        text-underline-offset: 3px;
        transition: text-decoration-color 0.15s ease, color 0.15s ease;
      }

      .newsTeaser:hover .newsTeaser-cta {
        text-decoration-color: var(--news-link);
      }

      .newsTeaser-ctaArrow {
        text-decoration: none;
        display: inline-block;
        transition: transform 0.15s ease;
      }

      .newsTeaser:hover .newsTeaser-ctaArrow {
        transform: translateX(3px);
      }

      @media (max-width: 640px) {
        .hero {
          min-height: min(70vh, 560px);
          padding: 72px 0 64px;
          background-position: center 30%;
        }

        .heroActions {
          flex-direction: column;
          align-items: stretch;
        }

        .heroActions .btnPrimary,
        .heroActions .btnGhost {
          width: 100%;
          justify-content: center;
        }
      }
    </style>
  </body>
</html>
