---
import '../../styles/admin-editorial.css';
import '../../styles/admin-member-pages.css';
import MemberAppLayout from '../../layouts/MemberAppLayout.astro';
import MemberSessionHeroMeta from './MemberSessionHeroMeta.astro';
import { memberCopy, memberPaths, type MemberLocale } from '../../lib/members/i18n';
import { mergeMemberUiStrings } from '../../lib/members/adminMemberUiCopy';
import { getMembershipCalendarYear } from '../../lib/members/membershipYear';

interface Props {
	locale: MemberLocale;
	email: string;
}

const { locale, email } = Astro.props;
const t = memberCopy[locale];
const paths = memberPaths[locale];
const calendarYear = getMembershipCalendarYear();
const priorYear = calendarYear - 1;

const adminKeys = [
	'adminLoading',
	'adminErrorGeneric',
	'adminAddMemberSubmit',
	'adminBreadcrumbAria',
	'adminPrimaryEmailLabel',
	'adminSecondaryEmailLabel',
	'adminSecondaryFirstNameLabel',
	'adminSecondaryLastNameLabel',
	'adminSecondaryPhoneLabel',
	'profileFirstName',
	'profileLastName',
	'profilePrimaryPhone',
	'profileLakeSearchLabel',
	'profileLakeSearchPlaceholder',
	'profileLakeCivic',
	'profileLakeStreet',
	'profileErrorFirstName',
	'profileErrorLastName',
	'adminAddMemberErrorDuplicateYear',
	'adminAddMemberErrorMemberNotFound',
	'adminAddMemberErrorNoLake',
	'adminAddMemberErrorAddressTaken',
	'profileLakeNoSuggestions',
	'profileLakeBackToSearch',
	'errorNetwork',
] as const;

const baseStrings = Object.fromEntries(adminKeys.map((k) => [k, t[k as keyof typeof t]])) as Record<string, string>;
const adminStrings = mergeMemberUiStrings(locale, baseStrings);

const adminMembersTabHref = `${paths.admin}?tab=members`;
const lakePlacesStrings = {
	manualLink: adminStrings.adminLakeManualLink,
	noSuggestions: t.profileLakeNoSuggestions,
	backToSearch: t.profileLakeBackToSearch,
	placesUnavailable: t.errorNetwork,
};

const lakeProfileInitJson = JSON.stringify({
	locale: locale === 'fr' ? 'fr' : 'en',
	strings: lakePlacesStrings,
	initialSource: null as string | null,
	initialPlaceId: '',
	initialFormatted: '',
	initialCivic: '',
	initialStreet: '',
});
---

<MemberAppLayout
  lang={locale}
  title={adminStrings.adminBreadcrumbAddMember}
  description={t.adminDescription}
  heroTitle={adminStrings.adminBreadcrumbAddMember}
  alignHeroWithAdmin
>
  <nav slot="hero-breadcrumb" class="memberWorkspaceBreadcrumb" aria-label={t.adminBreadcrumbAria}>
    <div class="memberWorkspaceBreadcrumbList" role="list">
      <div role="listitem" class="memberWorkspaceBreadcrumbItem">
        <a href={paths.admin} class="memberWorkspaceBreadcrumbLink">{t.adminHero}</a>
      </div>
      <div role="listitem" class="memberWorkspaceBreadcrumbItem">
        <a href={adminMembersTabHref} class="memberWorkspaceBreadcrumbLink">{t.adminNavMembers}</a>
      </div>
      <div role="listitem" class="memberWorkspaceBreadcrumbItem">
        <span class="memberWorkspaceBreadcrumbCurrent">{adminStrings.adminBreadcrumbAddMember}</span>
      </div>
    </div>
  </nav>
  <MemberSessionHeroMeta
    slot="hero-meta"
    locale={locale}
    email={email}
    signInRedirect={paths.signIn}
    variant="adminWorkspace"
  />
  <section class="section alt adminPage">
    <div class="container adminConsole adminMemberPageNarrow">
      <p id="admin-new-member-status" class="adminMemberStatus" aria-live="polite"></p>

      <h1 class="adminMemberPageTitle">{adminStrings.adminBreadcrumbAddMember}</h1>

      <form id="admin-new-member-form" class="adminMemberForm" aria-busy="false">
        <div class="adminMemberCard">
          <h2 class="adminMemberCardTitle">{adminStrings.adminProfileCardTitle}</h2>

          <div class="adminMemberFieldGroup">
            <span class="adminMemberSectionLabel">{adminStrings.adminPrimaryContactSection}</span>
            <div class="adminMemberGrid3">
              <label class="adminMemberField">
                <span class="adminMemberFieldLabel">{t.profileFirstName} *</span>
                <input type="text" name="first_name" class="adminMemberInput" required autocomplete="given-name" />
              </label>
              <label class="adminMemberField">
                <span class="adminMemberFieldLabel">{t.profileLastName} *</span>
                <input type="text" name="last_name" class="adminMemberInput" required autocomplete="family-name" />
              </label>
              <label class="adminMemberField">
                <span class="adminMemberFieldLabel">{t.adminPrimaryEmailLabel}</span>
                <input type="email" name="primary_email" class="adminMemberInput" autocomplete="email" />
              </label>
            </div>
            <label class="adminMemberField" style="margin-top:0.75rem;max-width:50%;">
              <span class="adminMemberFieldLabel">{t.profilePrimaryPhone}</span>
              <input type="text" name="primary_phone" class="adminMemberInput" autocomplete="tel" />
            </label>
          </div>

          <div class="adminMemberFieldGroup" style="margin-top:1.25rem;">
            <span class="adminMemberSectionLabel">{adminStrings.adminSecondaryContactSection}</span>
            <p class="adminMemberSectionNote">{adminStrings.adminSecondaryContactNote}</p>
            <div class="adminMemberGrid3">
              <label class="adminMemberField">
                <span class="adminMemberFieldLabel">{t.adminSecondaryFirstNameLabel}</span>
                <input type="text" name="secondary_first_name" class="adminMemberInput" />
              </label>
              <label class="adminMemberField">
                <span class="adminMemberFieldLabel">{t.adminSecondaryLastNameLabel}</span>
                <input type="text" name="secondary_last_name" class="adminMemberInput" />
              </label>
              <label class="adminMemberField">
                <span class="adminMemberFieldLabel">{t.adminSecondaryEmailLabel}</span>
                <input type="email" name="secondary_email" class="adminMemberInput" />
              </label>
            </div>
            <label class="adminMemberField" style="margin-top:0.75rem;max-width:50%;">
              <span class="adminMemberFieldLabel">{t.adminSecondaryPhoneLabel}</span>
              <input type="text" name="secondary_phone" class="adminMemberInput" />
            </label>
          </div>

          <div class="adminMemberFieldGroup" style="margin-top:1.25rem;">
            <span class="adminMemberSectionLabel">{adminStrings.adminLakeAddressSection}</span>
            <p class="adminMemberSectionNote">{adminStrings.adminLakeAddressVotingNote}</p>
            <input type="hidden" name="lake_address_source" id="am-lake_address_source" value="" />
            <input type="hidden" name="lake_google_place_id" id="am-lake_google_place_id" value="" />
            <input type="hidden" name="lake_formatted_address" id="am-lake_formatted_address" value="" />
            <input type="hidden" name="lake_civic_number" id="am-lake_civic_number" value="" />
            <input type="hidden" name="lake_street_name" id="am-lake_street_name" value="" />

            <div id="am-lake-search-section" class="lakeAddressSearchSection">
              <div id="am-lake-address-combobox-block" class="lakeAddressComboboxBlock">
                <div>
                  <label class="adminMemberFieldLabel" for="am-lake-address-search">
                    {t.profileLakeSearchLabel}
                  </label>
                  <div class="lakeAddressSearchWrap">
                    <input
                      class="adminMemberInput"
                      id="am-lake-address-search"
                      type="text"
                      autocomplete="off"
                      placeholder={t.profileLakeSearchPlaceholder}
                      role="combobox"
                      aria-autocomplete="list"
                      aria-controls="am-lake-address-suggestions"
                      aria-expanded="false"
                    />
                    <ul
                      id="am-lake-address-suggestions"
                      class="lakeAddressSuggestList"
                      hidden
                      role="listbox"
                      aria-label={t.profileLakeSearchLabel}
                    >
                    </ul>
                  </div>
                </div>
              </div>
              <p id="am-lake-places-summary" class="adminMemberLakeConfirm" hidden role="status" aria-live="polite"></p>
              <button type="button" class="adminMemberToggleLink" id="am-lake-change-address" hidden>
                {t.profileLakeBackToSearch}
              </button>
              <button type="button" class="adminMemberToggleLink" id="am-lake-manual-toggle">
                {adminStrings.adminLakeManualLink}
              </button>
            </div>

            <div id="am-lake-manual-section" class="lakeAddressManualSection" hidden>
              <div class="adminMemberGridManualLake">
                <label class="adminMemberField">
                  <span class="adminMemberFieldLabel">{t.profileLakeCivic}</span>
                  <input class="adminMemberInput" id="am-lake_civic_visible" type="text" autocomplete="off" />
                </label>
                <label class="adminMemberField">
                  <span class="adminMemberFieldLabel">{t.profileLakeStreet}</span>
                  <input class="adminMemberInput" id="am-lake_street_visible" type="text" autocomplete="off" />
                </label>
              </div>
              <button type="button" class="adminMemberToggleLink" id="am-lake-back-search">
                {adminStrings.adminLakeSearchLink}
              </button>
            </div>
          </div>

          <div class="adminMemberFieldGroup" style="margin-top:1.25rem;">
            <span class="adminMemberSectionLabel">{adminStrings.adminPreferencesSection}</span>
            <label class="adminMemberCheckboxRow">
              <input type="checkbox" name="email_opt_in" />
              <span>{adminStrings.adminEmailOptInAdmin}</span>
            </label>
            <label class="adminMemberField" style="margin-top:0.75rem;">
              <span class="adminMemberFieldLabel">{adminStrings.adminInternalNotesLabel}</span>
              <textarea name="notes" class="adminMemberTextarea" rows={3} placeholder={adminStrings.adminInternalNotesPlaceholder}></textarea>
            </label>
          </div>
        </div>

        <div class="adminMemberCard" id="admin-new-member-membership-section">
          <h2 class="adminMemberCardTitle">{adminStrings.adminMembershipCardTitle}</h2>
          <label class="adminMemberCheckboxRow" style="margin-bottom:1rem;">
            <input type="checkbox" name="create_membership" id="admin-new-member-create-membership" checked />
            <span>{t.adminAddMemberCreateMembership}</span>
          </label>

          <div id="admin-new-member-membership-fields">
            <div class="adminMemberGrid2" style="margin-bottom:1rem;">
              <label class="adminMemberField">
                <span class="adminMemberFieldLabel">{adminStrings.adminYearSelectLabel}</span>
                <select name="membership_year" id="admin-new-membership-year" class="adminMemberSelect" required></select>
              </label>
              <label class="adminMemberField">
                <span class="adminMemberFieldLabel">{adminStrings.adminTierSelectLabel}</span>
                <select name="membership_tier" id="admin-new-membership-tier" class="adminMemberSelect" required>
                  <option value="voting">{t.tierGeneral}</option>
                  <option value="associate">{t.tierAssociate}</option>
                </select>
              </label>
            </div>

            <span class="adminMemberSectionLabel">{adminStrings.adminPaymentRadioLabel}</span>
            <div style="display:flex;flex-direction:column;gap:0.5rem;margin-bottom:1rem;">
              <label class="adminMemberRadioRow">
                <input type="radio" name="membership_initial" value="pending" checked />
                <span>{adminStrings.adminPaymentStatusPending}</span>
              </label>
              <label class="adminMemberRadioRow">
                <input type="radio" name="membership_initial" value="active_with_payment" />
                <span>{adminStrings.adminPaymentStatusNow}</span>
              </label>
            </div>

            <p id="admin-new-voting-lake-warn" class="adminMemberWarn" hidden>
              {adminStrings.adminVotingLakeWarning}
            </p>

            <div id="admin-new-member-paid-fields" hidden>
              <div class="adminMemberGrid2">
                <label class="adminMemberField">
                  <span class="adminMemberFieldLabel">{t.adminAmountLabel}</span>
                  <input type="number" name="payment_amount" class="adminMemberInput" min="0" step="0.01" />
                </label>
                <label class="adminMemberField">
                  <span class="adminMemberFieldLabel">{t.adminMethodLabel}</span>
                  <select name="payment_method" class="adminMemberSelect">
                    <option value="e-transfer">{t.adminMethodEtransfer}</option>
                    <option value="cheque">{t.adminMethodCheque}</option>
                    <option value="cash">{t.adminMethodCash}</option>
                    <option value="other">{adminStrings.adminMethodOther}</option>
                  </select>
                </label>
              </div>
              <div class="adminMemberGrid2" style="margin-top:0.75rem;">
                <label class="adminMemberField">
                  <span class="adminMemberFieldLabel">{t.adminDateLabel}</span>
                  <input type="date" name="payment_date" id="admin-new-payment-date" class="adminMemberInput" />
                </label>
                <label class="adminMemberField">
                  <span class="adminMemberFieldLabel">{adminStrings.adminDonationPortionLabel}</span>
                  <input type="number" name="payment_donation_portion" class="adminMemberInput" min="0" step="0.01" />
                  <p class="adminMemberHint">{adminStrings.adminDonationPortionHint}</p>
                </label>
              </div>
              <label class="adminMemberField" style="margin-top:0.75rem;">
                <span class="adminMemberFieldLabel">{adminStrings.adminPaymentRefNotesLabel}</span>
                <input type="text" name="payment_reference" class="adminMemberInput" placeholder={adminStrings.adminPaymentRefNotesPlaceholder} />
              </label>
              <p class="adminMemberHint" style="margin-top:0.75rem;">{adminStrings.adminActivationHint}</p>
            </div>
          </div>
        </div>

        <div class="adminMemberFormActions">
          <button type="submit" class="adminMemberBtnPrimary" id="admin-new-member-submit">
            <span class="adminMemberSpinner" aria-hidden="true"></span>
            <span>{t.adminAddMemberSubmit}</span>
          </button>
          <a href={adminMembersTabHref} class="adminMemberLinkCancel">{adminStrings.adminCancelForm}</a>
        </div>
      </form>
    </div>
  </section>
</MemberAppLayout>

<script type="application/json" id="am-lake-init" set:html={lakeProfileInitJson}></script>
<script>
  import { initLakeAddressPlacesUi } from '../../scripts/lake-address-places-ui';

  const raw = document.getElementById('am-lake-init')?.textContent;
  if (raw) {
    const cfg = JSON.parse(raw) as {
      locale: 'en' | 'fr';
      strings: Record<string, string>;
      initialSource: string | null;
      initialPlaceId: string;
      initialFormatted: string;
      initialCivic: string;
      initialStreet: string;
    };

    const lakeSearch = document.getElementById('am-lake-address-search');
    const lakeSug = document.getElementById('am-lake-address-suggestions');
    const lakeSearchSection = document.getElementById('am-lake-search-section');
    const lakeManualSection = document.getElementById('am-lake-manual-section');
    const lakeSummary = document.getElementById('am-lake-places-summary');
    const lakeCivicH = document.getElementById('am-lake_civic_number');
    const lakeStreetH = document.getElementById('am-lake_street_name');
    const lakeSourceEl = document.getElementById('am-lake_address_source');
    const lakePlaceIdEl = document.getElementById('am-lake_google_place_id');
    const lakeFormattedEl = document.getElementById('am-lake_formatted_address');
    const lakeComboboxBlock = document.getElementById('am-lake-address-combobox-block');
    const lakeChangeAddressBtn = document.getElementById('am-lake-change-address');
    const lakeManualBtn = document.getElementById('am-lake-manual-toggle');
    const lakeBackBtn = document.getElementById('am-lake-back-search');
    const lakeCivicVis = document.getElementById('am-lake_civic_visible');
    const lakeStreetVis = document.getElementById('am-lake_street_visible');

    if (
      lakeSearch instanceof HTMLInputElement &&
      lakeSug instanceof HTMLUListElement &&
      lakeSearchSection instanceof HTMLElement &&
      lakeManualSection instanceof HTMLElement &&
      lakeCivicH instanceof HTMLInputElement &&
      lakeStreetH instanceof HTMLInputElement &&
      lakeSourceEl instanceof HTMLInputElement &&
      lakePlaceIdEl instanceof HTMLInputElement &&
      lakeFormattedEl instanceof HTMLInputElement &&
      lakeComboboxBlock instanceof HTMLElement &&
      lakeChangeAddressBtn instanceof HTMLButtonElement &&
      lakeManualBtn instanceof HTMLButtonElement &&
      lakeBackBtn instanceof HTMLButtonElement &&
      lakeCivicVis instanceof HTMLInputElement &&
      lakeStreetVis instanceof HTMLInputElement
    ) {
      initLakeAddressPlacesUi({
        locale: cfg.locale,
        strings: cfg.strings,
        comboboxBlock: lakeComboboxBlock,
        changeAddressToggle: lakeChangeAddressBtn,
        searchInput: lakeSearch,
        suggestionsEl: lakeSug,
        searchSection: lakeSearchSection,
        manualSection: lakeManualSection,
        summaryEl: lakeSummary,
        civicHidden: lakeCivicH,
        streetHidden: lakeStreetH,
        sourceInput: lakeSourceEl,
        placeIdInput: lakePlaceIdEl,
        formattedInput: lakeFormattedEl,
        manualToggle: lakeManualBtn,
        backToggle: lakeBackBtn,
        civicVisible: lakeCivicVis,
        streetVisible: lakeStreetVis,
        initialSource: cfg.initialSource,
        initialPlaceId: cfg.initialPlaceId,
        initialFormatted: cfg.initialFormatted,
        initialCivic: cfg.initialCivic,
        initialStreet: cfg.initialStreet,
      });
    }
  }
</script>

<script
  type="application/json"
  id="admin-member-new-data"
  set:html={JSON.stringify({ adminStrings, adminMemberDetailBase: paths.adminMembers, calendarYear, priorYear })}
></script>
<script>
  import { initAdminMemberNew } from '../../scripts/admin-member-new';
  const el = document.getElementById('admin-member-new-data');
  const raw = el?.textContent;
  if (raw) {
    const { adminStrings, adminMemberDetailBase, calendarYear, priorYear } = JSON.parse(raw) as {
      adminStrings: Record<string, string>;
      adminMemberDetailBase: string;
      calendarYear: number;
      priorYear: number;
    };
    initAdminMemberNew(adminStrings, adminMemberDetailBase, calendarYear, priorYear);
  }
</script>

<style>
  .memberWorkspaceBreadcrumbCurrent {
    color: var(--admin-text);
    font-weight: 500;
  }
</style>
