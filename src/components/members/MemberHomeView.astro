      linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.95));
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.04),
      0 16px 40px rgba(15, 23, 42, 0.07);
