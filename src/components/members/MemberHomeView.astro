    font-size: clamp(1.4rem, 2.5vw, 1.7rem);
    line-height: 1.16;
    letter-spacing: -0.025em;
    margin-bottom: 0.42rem;
    color: var(--text, #0f172a);
  }

  .memberSummaryEmail {
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--muted, #64748b);
  }

  .memberSummaryEdit {
    flex-shrink: 0;
    align-self: flex-start;
