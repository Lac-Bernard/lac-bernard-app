---
import MemberAppLayout from '../../layouts/MemberAppLayout.astro';
import MemberSessionHeroMeta from './MemberSessionHeroMeta.astro';
import {
	memberCopy,
	memberPaths,
	membershipTierLabel,
	type MemberLocale,
} from '../../lib/members/i18n';
import type { MemberAccountPayload } from '../../lib/members/accountData';
import { formatMemberCad, formatMemberLocaleDate } from '../../lib/members/formatMemberDisplay';
import { formatMemberPrimaryName } from '../../lib/members/memberDisplayName';
import { membershipCentsForTier } from '../../lib/membership/stripeCheckout';

interface Props {
	locale: MemberLocale;
	email: string;
	currentYear: number;
	accountData: MemberAccountPayload;
	checkoutFlash?: 'success' | 'cancelled' | 'error' | null;
}

const { locale, email, currentYear, accountData, checkoutFlash = null } = Astro.props;
const t = memberCopy[locale];
const paths = memberPaths[locale];
const { member, currentMemberships, historicalMemberships, currentYearPayments, votingAddressTaken } = accountData;

function memberPaymentMethodLabel(method: string | null): string {
	if (!method) return t.memberPaymentMethodUnknown;
	if (method === 'stripe') return t.memberPaymentMethodStripe;
	if (method === 'e-transfer') return t.memberPaymentMethodEtransfer;
	if (method === 'cheque') return t.memberPaymentMethodCheque;
	if (method === 'cash') return t.memberPaymentMethodCash;
	if (method === 'unknown') return t.memberPaymentMethodUnknown;
	return method;
}

function donationCategoryLabel(category: string | null | undefined): string {
	if (category === 'environment') return t.donationCategoryEnvironment;
	if (category === 'regatta') return t.donationCategoryRegatta;
	if (category === 'general') return t.donationCategoryGeneral;
	return category?.trim() || '';
}

function membershipRows(rows: typeof currentMemberships) {
	return rows.map((row) => ({
		...row,
		tierLabel: membershipTierLabel(row.tier, locale),
	}));
}

const thisYearMembership = currentMemberships.find((m) => m.year === currentYear) ?? null;
const hasActiveCurrentYear = thisYearMembership?.status === 'active';
const pendingThisYear =
	thisYearMembership?.status === 'pending' ? thisYearMembership : null;
const thisYearTierLabel = thisYearMembership
	? membershipTierLabel(thisYearMembership.tier, locale)
	: '';

const futureRows = membershipRows(currentMemberships.filter((m) => m.year > currentYear));
const historyRows = membershipRows(historicalMemberships);

const activeTitle = t.statusActiveTitle.replace('{{year}}', String(currentYear));
const inactiveTitle = t.statusInactiveTitle.replace('{{year}}', String(currentYear));
const pendingTitle = t.statusPendingTitle.replace('{{year}}', String(currentYear));

const interacMail = `mailto:${t.interacEmail}`;
const membershipMail = `mailto:${t.membershipEmail}`;

const pendingTierFullFeeCents =
	pendingThisYear ? membershipCentsForTier(pendingThisYear.tier) : null;
const pendingDuesPaidTowardMembership = pendingThisYear
	? currentYearPayments.reduce((s, p) => {
			const m = p.membership_amount;
			const n = typeof m === 'number' ? m : parseFloat(String(m ?? 0));
			return s + (Number.isFinite(n) ? n : 0);
		}, 0)
	: 0;
const pendingDuesPaidCents = Math.round(pendingDuesPaidTowardMembership * 100);
const pendingRemainderCents =
	pendingTierFullFeeCents != null
		? Math.max(0, pendingTierFullFeeCents - pendingDuesPaidCents)
		: null;
const pendingFeeCents = pendingRemainderCents;
const pendingMembershipFeeCad =
	pendingFeeCents != null ? (pendingFeeCents / 100).toFixed(2) : '0.00';
const showPendingDuesCredited =
	Boolean(pendingThisYear) && pendingDuesPaidCents > 0 && (pendingRemainderCents ?? 0) > 0;
const pendingDuesCreditedDisplay = formatMemberCad(locale, pendingDuesPaidTowardMembership);

const activeFeeCents =
	thisYearMembership?.status === 'active'
		? membershipCentsForTier(thisYearMembership.tier)
		: null;

const activeYearScope = t.statusActiveYearScope.replace('{{year}}', String(currentYear));

const currentYearDonationSum = currentYearPayments.reduce((sum, p) => {
	const d = p.donation_amount;
	if (d == null || !Number.isFinite(d)) return sum;
	return sum + d;
}, 0);
const hasCurrentYearDonationTotal = currentYearDonationSum > 0.0001;
const activePaymentOverviewLine =
	currentYearPayments.length === 0
		? ''
		: hasCurrentYearDonationTotal
			? t.memberActivePaymentOverview
					.replace('{{count}}', String(currentYearPayments.length))
					.replace('{{donation}}', formatMemberCad(locale, currentYearDonationSum))
			: t.memberActivePaymentOverviewFeesOnly.replace(
					'{{count}}',
					String(currentYearPayments.length),
				);

const activeTierFeeDisplay = thisYearMembership?.complimentary
	? t.memberActiveSnapshotFeeComplimentary
	: formatMemberCad(locale, activeFeeCents != null ? activeFeeCents / 100 : null);

const showMemberActions = Boolean(member);
const hasLakeAddress = Boolean(
	member &&
		member.lake_civic_number?.trim() &&
		member.lake_street_name?.trim(),
);
const lakeAddressLine =
	member?.lake_civic_number?.trim() && member?.lake_street_name?.trim()
		? `${member.lake_civic_number.trim()} ${member.lake_street_name.trim()}`
		: '';
const tierVotingExplainerWithAddressResolved = lakeAddressLine
	? t.tierGeneralExplainerWithAddress.replace('{{lakeAddress}}', lakeAddressLine)
	: t.tierGeneralExplainer;
const pendingCreateErrorGeneralAddressTakenResolved = t.pendingCreateErrorGeneralAddressTaken.replace(
	'{{lakeAddress}}',
	lakeAddressLine,
);
const canSelectVoting = hasLakeAddress && !votingAddressTaken;
const tierGeneralAddressTakenNoticeResolved = t.tierGeneralAddressTakenNotice
	.replace('{{lakeAddress}}', lakeAddressLine)
	.replace('{{year}}', String(currentYear));

const votingCents = membershipCentsForTier('voting');
const associateCents = membershipCentsForTier('associate');
const votingFeeCad =
	votingCents != null ? (votingCents / 100).toFixed(2) : '0.00';
const associateFeeCad =
	associateCents != null ? (associateCents / 100).toFixed(2) : '0.00';

/** Default-checked tier on inactive card: voting when it's selectable, else associate */
const inactiveModalTierLabel = membershipTierLabel(canSelectVoting ? 'voting' : 'associate', locale);
const inactiveModalFeeCad = canSelectVoting ? votingFeeCad : associateFeeCad;

const displayEmail = member ? (member.primary_email?.trim() || email) : '';
const memberPrimaryNameOnly = member ? formatMemberPrimaryName(member) : '';
const secondaryContactFirstName = member?.secondary_first_name?.trim() ?? '';
const secondaryContactLastName = member?.secondary_last_name?.trim() ?? '';
const secondaryContactEmail = member?.secondary_email?.trim() ?? '';
const secondaryContactPhone = member?.secondary_phone?.trim() ?? '';
const hasSecondaryContactInfo = Boolean(
	secondaryContactFirstName || secondaryContactLastName || secondaryContactEmail || secondaryContactPhone,
);
---

<MemberAppLayout
  lang={locale}
  title={t.homeTitle}
  description={t.homeDescription}
  heroTitle={t.homeHero}
>
  {email ? (
    <MemberSessionHeroMeta slot="hero-meta" locale={locale} email={email} signInRedirect={paths.signIn} />
  ) : null}
  <section class="section">
    <div class="container prose memberHomeProse">
      {checkoutFlash === 'success' && (
        <p class="checkoutBanner checkoutBannerSuccess" role="status">{t.checkoutSuccessBanner}</p>
      )}
      {checkoutFlash === 'cancelled' && (
        <p class="checkoutBanner checkoutBannerCancelled" role="status">{t.checkoutCancelledBanner}</p>
      )}
      {checkoutFlash === 'error' && (
        <p class="checkoutBanner checkoutBannerError" role="status">{t.checkoutErrorBanner}</p>
      )}

      {
        !member ? (
          <>
            <p class="muted">{t.noMemberForEmail}</p>
            <p>
              <a class="profileEditLink" href={`${paths.join}?next=${encodeURIComponent(paths.account)}`}>
                {t.linkCreateProfile}
              </a>
            </p>
          </>
        ) : (
          <>
            <div class="memberSummaryCard">
              <div class="memberSummaryHeader">
                <div class="memberSummaryIdentity">
                  <p class="memberSummaryName">{memberPrimaryNameOnly}</p>
                  <p class="memberSummaryEmail">{displayEmail}</p>
                </div>
                <a class="profileEditLink memberSummaryEdit" href={paths.edit}>{t.linkEditProfile}</a>
              </div>
              <div class="memberSummarySections">
                <section class="memberSummarySection" aria-labelledby="member-summary-info">
                  <h2 id="member-summary-info" class="memberSummarySectionTitle">{t.profileSectionPrimaryMember}</h2>
                  <dl class="memberSummaryDl">
                    <div class="memberSummaryDlRow">
                      <dt>{t.profileSignInEmail}</dt>
                      <dd>{displayEmail || t.homeAddressNotOnFile}</dd>
                    </div>
                    <div class="memberSummaryDlRow">
                      <dt>{t.profilePrimaryPhone}</dt>
                      <dd>{member?.primary_phone?.trim() || t.homeAddressNotOnFile}</dd>
                    </div>
                  </dl>
                </section>

                {hasSecondaryContactInfo && (
                  <section class="memberSummarySection" aria-labelledby="member-summary-secondary-contact">
                    <h2 id="member-summary-secondary-contact" class="memberSummarySectionTitle">{t.profileSectionSecondaryMember}</h2>
                    <dl class="memberSummaryDl">
                      <div class="memberSummaryDlRow">
                        <dt>{t.profileSecondaryFirstName}</dt>
                        <dd>{secondaryContactFirstName || t.homeAddressNotOnFile}</dd>
                      </div>
                      <div class="memberSummaryDlRow">
                        <dt>{t.profileSecondaryLastName}</dt>
                        <dd>{secondaryContactLastName || t.homeAddressNotOnFile}</dd>
                      </div>
                      <div class="memberSummaryDlRow">
                        <dt>{t.profileSecondaryEmail}</dt>
                        <dd>{secondaryContactEmail || t.homeAddressNotOnFile}</dd>
                      </div>
                      <div class="memberSummaryDlRow">
                        <dt>{t.profileSecondaryPhone}</dt>
                        <dd>{secondaryContactPhone || t.homeAddressNotOnFile}</dd>
                      </div>
                    </dl>
                  </section>
                )}

                <section class="memberSummarySection" aria-labelledby="member-summary-lake">
                  <h2 id="member-summary-lake" class="memberSummarySectionTitle">{t.profileSectionLake}</h2>
                  <p class="memberSummarySectionHelp">{t.profileLakeDisplayHelp}</p>
                  <dl class="memberSummaryDl">
                    <div class="memberSummaryDlRow">
                      <dt>{t.profileLakeCivic}</dt>
                      <dd>{member?.lake_civic_number?.trim() || t.homeAddressNotOnFile}</dd>
                    </div>
                    <div class="memberSummaryDlRow">
                      <dt>{t.profileLakeStreet}</dt>
                      <dd>{member?.lake_street_name?.trim() || t.homeAddressNotOnFile}</dd>
                    </div>
                  </dl>
                </section>
              </div>
            </div>

            {hasActiveCurrentYear ? (
              <div class="statusCard statusCardActive memberActiveCard" role="status">
                <header class="memberActiveHero">
                  <div class="memberActiveHeroTop">
                    <span class="memberActiveBadge">{t.memberActiveBadge}</span>
                    <span class="memberActiveYearChip">{currentYear}</span>
                  </div>
                  <div class="memberActiveHeroTitleRow">
                    <div class="memberActiveIcon" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                    </div>
                    <h2 class="memberActiveTitle">{activeTitle}</h2>
                  </div>
                  <p class="memberActiveScope">{activeYearScope}</p>
                </header>

                <div class="memberActiveSnapshot">
                  <h3 class="memberActiveSnapshotHeading">{t.memberActiveSnapshotHeading}</h3>
                  <dl class="memberActiveSnapshotGrid">
                    <div class="memberActiveSnapshotCell">
                      <dt>{t.memberActiveSnapshotTypeLabel}</dt>
                      <dd>{thisYearTierLabel}</dd>
                    </div>
                    <div class="memberActiveSnapshotCell">
                      <dt>{t.memberActiveSnapshotFeeLabel}</dt>
                      <dd>{activeTierFeeDisplay}</dd>
                    </div>
                  </dl>
                  {thisYearMembership?.tier === 'voting' && (
                    <div class="memberActiveLake">
                      <p class="memberActiveLakeLabel">{t.statusActiveGeneralVoteLabel}</p>
                      <p class="memberActiveLakeValue">{lakeAddressLine || t.homeAddressNotOnFile}</p>
                    </div>
                  )}
                </div>

                <section class="memberActivePayments" aria-labelledby="member-active-payments-heading">
                  <div class="memberActivePaymentsHead">
                    <h3 id="member-active-payments-heading" class="memberActivePaymentsTitle">
                      {t.memberPaymentsSectionTitle}
                    </h3>
                    <p class="memberActivePaymentsLead">{t.memberPaymentsSectionLead}</p>
                    {activePaymentOverviewLine ? (
                      <p class="memberActivePaymentsOverview">{activePaymentOverviewLine}</p>
                    ) : null}
                  </div>
                  <div class="memberActivePaymentsBody">
                    {currentYearPayments.length === 0 ? (
                      <p class="memberActivePaymentsEmpty">{t.memberPaymentsEmpty}</p>
                    ) : (
                      <ul class="memberActivePaymentList">
                              {currentYearPayments.map((p) => {
                                const donationNote = (p.donation_note ?? '').trim();
                                const categoryLabel = donationCategoryLabel(p.donation_category);
                                const recordNote = (p.notes ?? '').trim();
                                const paymentRefRaw = (p.payment_id ?? '').trim();
                                const hasPaymentTechnicalDetails = Boolean(recordNote || paymentRefRaw);
                                const dAmt = p.donation_amount;
                          const showDonation =
                            dAmt != null && Number.isFinite(dAmt) && dAmt > 0.0001;
                          return (
                            <li class="memberActivePaymentItem">
                              <div class="memberActivePaymentItemHeader">
                                <div class="memberActivePaymentItemMeta">
                                  <time
                                    class="memberActivePaymentDate"
                                    datetime={p.date ?? undefined}
                                  >
                                    {formatMemberLocaleDate(locale, p.date)}
                                  </time>
                                  <span class="memberActivePaymentMethod">
                                    {memberPaymentMethodLabel(p.method)}
                                  </span>
                                </div>
                                <div class="memberActivePaymentTotalBlock">
                                  <span class="memberActivePaymentTotalLabel">
                                    {t.memberActivePaymentItemTotal}
                                  </span>
                                  <span class="memberActivePaymentTotalAmount">
                                    {formatMemberCad(locale, p.amount)}
                                  </span>
                                </div>
                              </div>
                              <div class="memberActivePaymentSplit">
                                <span class="memberActivePaymentSplitChip">
                                  <span class="memberActivePaymentSplitLabel">
                                    {t.memberActivePaymentSplitMembership}
                                  </span>
                                  <span class="memberActivePaymentSplitValue">
                                    {formatMemberCad(locale, p.membership_amount)}
                                  </span>
                                </span>
                                {showDonation ? (
                                  <span class="memberActivePaymentSplitChip memberActivePaymentSplitChip--donation">
                                    <span class="memberActivePaymentSplitLabel">
                                      {t.memberActivePaymentSplitDonation}
                                    </span>
                                    <span class="memberActivePaymentSplitValue">
                                      {formatMemberCad(locale, p.donation_amount)}
                                    </span>
                                  </span>
                                ) : null}
                              </div>
                              {showDonation && categoryLabel ? (
                                <p class="memberActivePaymentRefLine">
                                  <span class="memberActivePaymentRefKey">{t.memberActivePaymentDonationCategory}</span>
                                  <span class="memberActivePaymentRefVal">{categoryLabel}</span>
                                </p>
                              ) : null}
                              {donationNote ? (
                                <p class="memberActivePaymentRefLine">
                                  <span class="memberActivePaymentRefKey">{t.memberPaymentsColNote}</span>
                                  <span class="memberActivePaymentRefVal memberActivePaymentRefVal--wrap">
                                    {donationNote}
                                  </span>
                                </p>
                              ) : null}
                              {hasPaymentTechnicalDetails ? (
                                <details class="memberActivePaymentDetails">
                                  <summary class="memberActivePaymentDetailsSummary">
                                    {t.memberPaymentSeeDetails}
                                  </summary>
                                  <div class="memberActivePaymentDetailsBody">
                                    {recordNote ? (
                                      <p class="memberActivePaymentRefLine">
                                        <span class="memberActivePaymentRefKey">{t.memberPaymentsColRecordNote}</span>
                                        <span class="memberActivePaymentRefVal memberActivePaymentRefVal--wrap">
                                          {recordNote}
                                        </span>
                                      </p>
                                    ) : null}
                                    {paymentRefRaw !== '' ? (
                                      <p class="memberActivePaymentRefLine">
                                        <span class="memberActivePaymentRefKey">{t.memberActivePaymentReference}</span>
                                        <span class="memberActivePaymentRefVal memberActivePaymentRefVal--wrap">
                                          {paymentRefRaw}
                                        </span>
                                      </p>
                                    ) : null}
                                  </div>
                                </details>
                              ) : null}
                            </li>
                          );
                        })}
                      </ul>
                    )}
                  </div>
                </section>

                {futureRows.length > 0 ? (
                  <p class="memberActivePrepaid">
                    {t.statusActivePrepaidTeaser.replace('{{count}}', String(futureRows.length))}
                  </p>
                ) : null}
              </div>
            ) : pendingThisYear ? (
              <div class="statusCard statusCardPending" role="status">
                <div class="statusPendingHead">
                  <div class="statusPendingMark" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10" />
                      <polyline points="12 6 12 12 16 14" />
                    </svg>
                  </div>
                  <h2 class="statusTitle">{pendingTitle}</h2>
                </div>
                <div class="statusCardBody statusCardBodyPending">
                  <p class="statusPendingLead">{t.statusPendingLead}</p>

                  <div class="pendingTierSummary">
                    <p class="tierLegend">{t.statusActiveTierLabel}</p>
                    <div class="pendingTierTile">
                      <div class="pendingTierTileRow">
                        <span class="pendingTierName">{thisYearTierLabel}</span>
                        <span class="pendingTierFee">{pendingMembershipFeeCad} CAD</span>
                      </div>
                    </div>
                    {showPendingDuesCredited && (
                      <p class="pendingDuesCredited">{t.statusPendingDuesCredited.replace('{{amount}}', pendingDuesCreditedDisplay)}</p>
                    )}
                  </div>

                  <div class="payPrimary">
                    <button type="button" class="btnPrimary payCardBtn payCardBtnFull" id="open-checkout-modal">
                      {t.payWithCard}
                    </button>
                  </div>

                  <dialog id="checkout-modal" class="checkoutModal" aria-labelledby="checkout-modal-title">
                    <div class="checkoutModalInner">
                      <form id="checkout-modal-form" class="checkoutModalForm" data-membership-id={pendingThisYear.id}>
                        <div class="checkoutModalScroll">
                          <h2 id="checkout-modal-title" class="checkoutModalHeading">{t.checkoutModalTitle}</h2>
                          <dl class="checkoutModalSummary">
                            <div class="checkoutModalSummaryRow">
                              <dt>{t.checkoutModalMembershipLabel}</dt>
                              <dd id="checkout-modal-summary-tier">{thisYearTierLabel}</dd>
                            </div>
                            <div class="checkoutModalSummaryRow">
                              <dt>{t.checkoutModalFeeLabel}</dt>
                              <dd
                                id="checkout-modal-summary-fee"
                                data-fee-cents={pendingFeeCents ?? 0}
                              >
                                {pendingMembershipFeeCad} CAD
                              </dd>
                            </div>
                            <div class="checkoutModalSummaryRow checkoutModalSummaryRow--donation">
                              <dt>{t.checkoutModalDonationLabel}</dt>
                              <dd class="checkoutModalDonationDd">
                                <div class="checkoutModalDonationWrap">
                                  <input
                                    type="number"
                                    class="checkoutModalInput checkoutModalDonationInput"
                                    id="modal-donation"
                                    name="donation"
                                    min="0"
                                    max="50000"
                                    step="0.01"
                                    placeholder="0.00"
                                    inputmode="decimal"
                                    aria-label={t.donationLabel}
                                  />
                                  <span class="checkoutModalAmountSuffix">CAD</span>
                                </div>
                              </dd>
                            </div>
                            <div class="checkoutModalSummaryRow checkoutModalSummaryRow--donationCategory">
                              <dt>
                                <label for="modal-donation-category">{t.donationCategoryLabel}</label>
                              </dt>
                              <dd>
                                <select
                                  class="checkoutModalInput checkoutModalCategorySelect"
                                  id="modal-donation-category"
                                  name="donationCategory"
                                  aria-label={t.donationCategoryLabel}
                                >
                                  <option value="environment" selected>{t.donationCategoryEnvironment}</option>
                                  <option value="regatta">{t.donationCategoryRegatta}</option>
                                  <option value="general">{t.donationCategoryGeneral}</option>
                                </select>
                              </dd>
                            </div>
                            <div class="checkoutModalSummaryRow checkoutModalSummaryRow--total">
                              <dt>{t.checkoutModalTotalLabel}</dt>
                              <dd id="checkout-modal-summary-total" aria-live="polite">
                                {pendingMembershipFeeCad} CAD
                              </dd>
                            </div>
                          </dl>
                          <div class="checkoutModalField checkoutModalNoteField">
                            <label class="donationLabel" for="modal-donation-note">{t.donationNoteLabel}</label>
                            <textarea
                              class="donationNoteInput"
                              id="modal-donation-note"
                              name="donationNote"
                              rows="2"
                              maxlength="500"
                              aria-describedby="modal-donation-note-hint"
                            ></textarea>
                            <p id="modal-donation-note-hint" class="checkoutModalNoteHint">{t.checkoutModalNoteHint}</p>
                          </div>
                        </div>
                        <p id="pay-checkout-message" class="actionMessage checkoutModalError" role="status" aria-live="polite"></p>
                        <div class="checkoutModalActions">
                          <button type="button" class="btnGhost checkoutModalBtnSecondary" id="checkout-modal-cancel">
                            {t.checkoutModalCancel}
                          </button>
                          <button
                            type="submit"
                            class="btnPrimary checkoutModalBtnPrimary checkoutModalSubmit"
                            id="checkout-modal-submit"
                          >
                            <span class="checkoutModalSubmit-spinner" aria-hidden="true"></span>
                            <span class="checkoutModalSubmit-label">{t.checkoutModalContinue}</span>
                          </button>
                        </div>
                      </form>
                    </div>
                  </dialog>

                  <div class="payAlt">
                    <h3 class="payAltTitle">{t.otherPaymentTitle}</h3>
                    <div class="payMethodGrid">
                      <div class="payMethodCard">
                        <div class="payMethodCardTitle">{t.payInteracTitle}</div>
                        <p class="payMethodCardBody">
                          {t.payInteracBeforeLink}
                          <a href={interacMail}>{t.interacEmail}</a>
                          {t.payInteracAfterLink}
                        </p>
                      </div>
                      <div class="payMethodCard">
                        <div class="payMethodCardTitle">{t.payChequeTitle}</div>
                        <p class="payMethodCardBody payAddress">{t.payChequeAddress}</p>
                      </div>
                      <div class="payMethodCard">
                        <div class="payMethodCardTitle">{t.payCashTitle}</div>
                        <p class="payMethodCardBody">
                          {t.payCashBeforeLink}
                          <a href={membershipMail}>{t.membershipEmail}</a>
                          {t.payCashAfterLink}
                        </p>
                      </div>
                    </div>
                    <div
                      class="payAltDonationBlurb"
                      role="group"
                      aria-labelledby="pay-alt-donation-heading"
                    >
                      <p id="pay-alt-donation-heading" class="payAltDonationTitle">
                        {t.otherPaymentDonationTitle}
                      </p>
                      <p class="payAltDonationBody">{t.otherPaymentDonationBody}</p>
                    </div>
                  </div>

                  <div class="cancelRow">
                    <button type="button" class="btnGhost cancelPendingBtn checkoutModalSubmit" id="cancel-pending-btn" data-membership-id={pendingThisYear.id}>
                      <span class="checkoutModalSubmit-spinner" aria-hidden="true"></span>
                      <span class="checkoutModalSubmit-label">{t.cancelPending}</span>
                    </button>
                    <p id="cancel-pending-message" class="actionMessage" role="status" aria-live="polite"></p>
                  </div>
                </div>
              </div>
            ) : (
              <div class="statusCard statusCardInactive" role="status">
                <div class="statusInactiveHead">
                  <div class="statusInactiveMark" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                      <line x1="16" y1="2" x2="16" y2="6" />
                      <line x1="8" y1="2" x2="8" y2="6" />
                      <line x1="3" y1="10" x2="21" y2="10" />
                    </svg>
                  </div>
                  <h2 class="statusTitle">{inactiveTitle}</h2>
                </div>
                <div class="statusCardBody statusCardBodyInactive">
                  <p class="statusLead">{t.statusInactiveLead}</p>
                  <ul class="statusSteps">
                    <li>{t.statusInactiveStep1}</li>
                    <li>{t.statusInactiveStep2}</li>
                    <li>{t.statusInactiveStep3}</li>
                  </ul>

                  <form id="create-pending-form" class="createPendingForm">
                    <fieldset class="tierFieldset">
                      <legend class="tierLegend">{t.tierChoiceLegend}</legend>
                      <div class="tierGrid">
                        <label class="tierOption tierOptionTile">
                          <input
                            type="radio"
                            name="tier"
                            value="voting"
                            checked={canSelectVoting}
                            disabled={!canSelectVoting}
                            title={!hasLakeAddress ? t.tierGeneralBlockedLead : votingAddressTaken ? tierGeneralAddressTakenNoticeResolved : undefined}
                          />
                          <span class="tierOptionBody">
                            <span class="tierOptionTitleRow">
                              <span class="tierOptionTitle">{t.tierGeneral}</span>
                              <span class="tierOptionPriceBadge">{votingFeeCad} CAD</span>
                            </span>
                            <span class="tierOptionExplainer">
                              {votingAddressTaken
                                ? tierGeneralAddressTakenNoticeResolved
                                : hasLakeAddress
                                  ? tierVotingExplainerWithAddressResolved
                                  : t.tierGeneralExplainer}
                            </span>
                          </span>
                        </label>
                        <label class="tierOption tierOptionTile">
                          <input type="radio" name="tier" value="associate" checked={!canSelectVoting} />
                          <span class="tierOptionBody">
                            <span class="tierOptionTitleRow">
                              <span class="tierOptionTitle">{t.tierAssociate}</span>
                              <span class="tierOptionPriceBadge">{associateFeeCad} CAD</span>
                            </span>
                            <span class="tierOptionExplainer">{t.tierAssociateExplainer}</span>
                          </span>
                        </label>
                      </div>
                    </fieldset>
                    {!hasLakeAddress && (
                      <p class="tierBlockedNote">
                        {t.tierGeneralBlockedLead}{' '}
                        <a class="profileEditLink" href={paths.edit}>{t.linkEditProfile}</a>
                      </p>
                    )}
                    <div class="createPendingPayRow">
                      <button type="button" class="btnPrimary payCardBtn payCardBtnFull" id="open-checkout-modal">
                        {t.payWithCard}
                      </button>
                      <button
                        type="button"
                        class="btnGhost createPendingManualBtn checkoutModalSubmit"
                        id="create-pending-manual-btn"
                      >
                        <span class="checkoutModalSubmit-spinner" aria-hidden="true"></span>
                        <span class="checkoutModalSubmit-label">{t.payOtherMethodsBtn}</span>
                      </button>
                    </div>
                    <p id="create-pending-message" class="actionMessage" role="status" aria-live="polite"></p>
                  </form>

                  <dialog id="checkout-modal" class="checkoutModal" aria-labelledby="checkout-modal-title">
                    <div class="checkoutModalInner">
                      <form id="checkout-modal-form" class="checkoutModalForm" data-membership-id="">
                        <div class="checkoutModalScroll">
                          <h2 id="checkout-modal-title" class="checkoutModalHeading">{t.checkoutModalTitle}</h2>
                          <dl class="checkoutModalSummary">
                            <div class="checkoutModalSummaryRow">
                              <dt>{t.checkoutModalMembershipLabel}</dt>
                              <dd id="checkout-modal-summary-tier">{inactiveModalTierLabel}</dd>
                            </div>
                            <div class="checkoutModalSummaryRow">
                              <dt>{t.checkoutModalFeeLabel}</dt>
                              <dd
                                id="checkout-modal-summary-fee"
                                data-fee-cents={canSelectVoting ? (votingCents ?? 0) : (associateCents ?? 0)}
                              >
                                {inactiveModalFeeCad} CAD
                              </dd>
                            </div>
                            <div class="checkoutModalSummaryRow checkoutModalSummaryRow--donation">
                              <dt>{t.checkoutModalDonationLabel}</dt>
                              <dd class="checkoutModalDonationDd">
                                <div class="checkoutModalDonationWrap">
                                  <input
                                    type="number"
                                    class="checkoutModalInput checkoutModalDonationInput"
                                    id="modal-donation"
                                    name="donation"
                                    min="0"
                                    max="50000"
                                    step="0.01"
                                    placeholder="0.00"
                                    inputmode="decimal"
                                    aria-label={t.donationLabel}
                                  />
                                  <span class="checkoutModalAmountSuffix">CAD</span>
                                </div>
                              </dd>
                            </div>
                            <div class="checkoutModalSummaryRow checkoutModalSummaryRow--donationCategory">
                              <dt>
                                <label for="modal-donation-category">{t.donationCategoryLabel}</label>
                              </dt>
                              <dd>
                                <select
                                  class="checkoutModalInput checkoutModalCategorySelect"
                                  id="modal-donation-category"
                                  name="donationCategory"
                                  aria-label={t.donationCategoryLabel}
                                >
                                  <option value="environment" selected>{t.donationCategoryEnvironment}</option>
                                  <option value="regatta">{t.donationCategoryRegatta}</option>
                                  <option value="general">{t.donationCategoryGeneral}</option>
                                </select>
                              </dd>
                            </div>
                            <div class="checkoutModalSummaryRow checkoutModalSummaryRow--total">
                              <dt>{t.checkoutModalTotalLabel}</dt>
                              <dd id="checkout-modal-summary-total" aria-live="polite">
                                {inactiveModalFeeCad} CAD
                              </dd>
                            </div>
                          </dl>
                          <div class="checkoutModalField checkoutModalNoteField">
                            <label class="donationLabel" for="modal-donation-note">{t.donationNoteLabel}</label>
                            <textarea
                              class="donationNoteInput"
                              id="modal-donation-note"
                              name="donationNote"
                              rows="2"
                              maxlength="500"
                              aria-describedby="modal-donation-note-hint"
                            ></textarea>
                            <p id="modal-donation-note-hint" class="checkoutModalNoteHint">{t.checkoutModalNoteHint}</p>
                          </div>
                        </div>
                        <p id="pay-checkout-message" class="actionMessage checkoutModalError" role="status" aria-live="polite"></p>
                        <div class="checkoutModalActions">
                          <button type="button" class="btnGhost checkoutModalBtnSecondary" id="checkout-modal-cancel">
                            {t.checkoutModalCancel}
                          </button>
                          <button
                            type="submit"
                            class="btnPrimary checkoutModalBtnPrimary checkoutModalSubmit"
                            id="checkout-modal-submit"
                          >
                            <span class="checkoutModalSubmit-spinner" aria-hidden="true"></span>
                            <span class="checkoutModalSubmit-label">{t.checkoutModalContinue}</span>
                          </button>
                        </div>
                      </form>
                    </div>
                  </dialog>
                </div>
              </div>
            )}

            {futureRows.length > 0 && (
              <section
                class="memberRecordsCard memberRecordsCardPrepaid"
                aria-labelledby="member-prepaid-heading"
              >
                <h2 id="member-prepaid-heading" class="memberRecordsTitle">
                  {t.membershipPrepaidSection}
                </h2>
                <p class="memberRecordsLead">{t.membershipPrepaidLead}</p>
                <div class="memberRecordsTableScroll">
                  <table class="memberRecordsTable">
                    <thead>
                      <tr>
                        <th scope="col">{t.membershipTableYear}</th>
                        <th scope="col">{t.membershipTableType}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {futureRows.map((row) => (
                        <tr>
                          <td class="memberRecordsCellYear">{row.year}</td>
                          <td>{row.tierLabel}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </section>
            )}

            {historyRows.length > 0 && (
              <section
                class="memberRecordsCard memberRecordsCardHistory"
                aria-labelledby="member-history-heading"
              >
                <h2 id="member-history-heading" class="memberRecordsTitle">
                  {t.membershipHistorySection}
                </h2>
                <p class="memberRecordsLead memberRecordsLeadMuted">{t.membershipHistoryLead}</p>
                <div class="memberRecordsTableScroll">
                  <table class="memberRecordsTable">
                    <thead>
                      <tr>
                        <th scope="col">{t.membershipTableYear}</th>
                        <th scope="col">{t.membershipTableType}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {historyRows.map((row) => (
                        <tr>
                          <td class="memberRecordsCellYear">{row.year}</td>
                          <td>{row.tierLabel}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </section>
            )}
          </>
        )
      }
    </div>
  </section>
</MemberAppLayout>

{showMemberActions && (
  <script
    define:vars={{
      errNetwork: t.errorNetwork,
      errUnauthorized: t.pendingCreateErrorUnauthorized,
      errAlreadyActive: t.pendingCreateErrorAlreadyActive,
      errAlreadyPending: t.pendingCreateErrorAlreadyPending,
      errCreateGeneric: t.pendingCreateErrorGeneric,
      errCancelGeneric: t.pendingCancelErrorGeneric,
      errCancelNotFound: t.pendingCancelErrorNotFound,
      memberLocale: locale,
      errCheckoutGeneric: t.checkoutErrorGeneric,
      errCheckoutStripeMisconfigured: t.checkoutStripeMisconfigured,
      errCheckoutInvalidDonation: t.checkoutInvalidDonation,
      errCheckoutInvalidDonationNote: t.checkoutInvalidDonationNote,
      errCheckoutInvalidDonationCategory: t.checkoutInvalidDonationCategory,
      errCheckoutNothingDue: t.checkoutErrorNothingDue,
      checkoutModalContinue: t.checkoutModalContinue,
      checkoutModalContinuing: t.checkoutModalContinuing,
      errNoLake: t.pendingCreateErrorNoLakeAddress,
      errGeneralTaken: pendingCreateErrorGeneralAddressTakenResolved,
      tierLabelVoting: t.tierGeneral,
      tierLabelAssociate: t.tierAssociate,
      feeVotingDisplay: `${votingFeeCad} CAD`,
      feeAssociateDisplay: `${associateFeeCad} CAD`,
      feeVotingCents: votingCents ?? 0,
      feeAssociateCents: associateCents ?? 0,
    }}
  >
    function createErrorMessage(code) {
      if (code === 'unauthorized') return errUnauthorized;
      if (code === 'already_active') return errAlreadyActive;
      if (code === 'already_pending') return errAlreadyPending;
      if (code === 'no_lake_address') return errNoLake;
      if (code === 'voting_address_taken') return errGeneralTaken;
      return errCreateGeneric;
    }

    function formatCadFromCents(cents) {
      return (cents / 100).toFixed(2) + ' CAD';
    }

    function updateCheckoutModalTotal() {
      const feeEl = document.getElementById('checkout-modal-summary-fee');
      const totalEl = document.getElementById('checkout-modal-summary-total');
      const donationEl = document.getElementById('modal-donation');
      if (!feeEl || !totalEl) return;
      const feeRaw = feeEl.getAttribute('data-fee-cents');
      const feeCents = feeRaw ? parseInt(feeRaw, 10) : 0;
      const feeSafe = Number.isFinite(feeCents) ? feeCents : 0;
      let donationCents = 0;
      if (donationEl) {
        const v = String(donationEl.value ?? '').trim();
        if (v !== '') {
          const n = parseFloat(v);
          if (Number.isFinite(n) && n >= 0) {
            donationCents = Math.round(n * 100);
          }
        }
      }
      totalEl.textContent = formatCadFromCents(feeSafe + donationCents);
    }

    function syncCheckoutModalSummaryFromTierForm() {
      const tierEl = document.getElementById('checkout-modal-summary-tier');
      const feeEl = document.getElementById('checkout-modal-summary-fee');
      if (!tierEl || !feeEl) return;
      const form = document.getElementById('create-pending-form');
      const input = form?.querySelector('input[name="tier"]:checked');
      const tier = input && input instanceof HTMLInputElement ? input.value : 'associate';
      if (tier === 'voting') {
        tierEl.textContent = tierLabelVoting;
        feeEl.textContent = feeVotingDisplay;
        feeEl.setAttribute('data-fee-cents', String(feeVotingCents));
      } else {
        tierEl.textContent = tierLabelAssociate;
        feeEl.textContent = feeAssociateDisplay;
        feeEl.setAttribute('data-fee-cents', String(feeAssociateCents));
      }
      updateCheckoutModalTotal();
    }

    const createForm = document.getElementById('create-pending-form');
    const createMsg = document.getElementById('create-pending-message');
    const manualPendingBtn = document.getElementById('create-pending-manual-btn');

    manualPendingBtn?.addEventListener('click', async () => {
      if (!createMsg || !createForm || !manualPendingBtn) return;
      createMsg.textContent = '';
      manualPendingBtn.setAttribute('disabled', 'true');
      manualPendingBtn.classList.add('is-loading');
      const fd = new FormData(createForm);
      const tier = String(fd.get('tier') ?? '');
      try {
        const res = await fetch('/api/membership/create-pending', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tier }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          createMsg.textContent = createErrorMessage(data.error) || errCreateGeneric;
          return;
        }
        window.location.reload();
      } catch {
        createMsg.textContent = errNetwork;
      } finally {
        manualPendingBtn.removeAttribute('disabled');
        manualPendingBtn.classList.remove('is-loading');
      }
    });

    const cancelBtn = document.getElementById('cancel-pending-btn');
    const cancelMsg = document.getElementById('cancel-pending-message');

    cancelBtn?.addEventListener('click', async () => {
      if (!cancelMsg || !cancelBtn) return;
      const id = cancelBtn.getAttribute('data-membership-id');
      if (!id) return;
      cancelMsg.textContent = '';
      cancelBtn.setAttribute('disabled', 'true');
      cancelBtn.classList.add('is-loading');
      try {
        const res = await fetch('/api/membership/cancel-pending', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ membershipId: id }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          cancelMsg.textContent =
            data.error === 'not_found' ? errCancelNotFound : errCancelGeneric;
          return;
        }
        window.location.reload();
      } catch {
        cancelMsg.textContent = errNetwork;
      } finally {
        cancelBtn.removeAttribute('disabled');
        cancelBtn.classList.remove('is-loading');
      }
    });

    const checkoutModal = document.getElementById('checkout-modal');
    const openCheckoutBtn = document.getElementById('open-checkout-modal');
    const checkoutModalForm = document.getElementById('checkout-modal-form');
    const checkoutMsg = document.getElementById('pay-checkout-message');
    const checkoutSubmit = document.getElementById('checkout-modal-submit');
    const checkoutSubmitLabel = checkoutSubmit?.querySelector('.checkoutModalSubmit-label');
    const donationInput = document.getElementById('modal-donation');
    const donationCategoryInput = document.getElementById('modal-donation-category');
    const donationNoteInput = document.getElementById('modal-donation-note');

    function setCheckoutSubmitLoading(loading) {
      if (!checkoutModalForm || !checkoutSubmit) return;
      checkoutModalForm.setAttribute('aria-busy', loading ? 'true' : 'false');
      checkoutSubmit.classList.toggle('is-loading', loading);
      checkoutSubmit.toggleAttribute('disabled', loading);
      if (checkoutSubmitLabel) {
        checkoutSubmitLabel.textContent = loading ? checkoutModalContinuing : checkoutModalContinue;
      }
    }

    openCheckoutBtn?.addEventListener('click', () => {
      if (checkoutMsg) checkoutMsg.textContent = '';
      checkoutModalForm?.reset();
      setCheckoutSubmitLoading(false);
      if (createForm) {
        syncCheckoutModalSummaryFromTierForm();
      } else {
        updateCheckoutModalTotal();
      }
      checkoutModal?.showModal();
    });

    donationInput?.addEventListener('input', () => {
      updateCheckoutModalTotal();
    });

    document.getElementById('checkout-modal-cancel')?.addEventListener('click', () => {
      checkoutModalForm?.reset();
      if (checkoutMsg) checkoutMsg.textContent = '';
      setCheckoutSubmitLoading(false);
      checkoutModal?.close();
    });

    checkoutModalForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!checkoutMsg || !checkoutSubmit || !checkoutModalForm) return;
      checkoutMsg.textContent = '';
      let donationDollars = 0;
      if (donationInput) {
        const v = String(donationInput.value ?? '').trim();
        if (v === '') {
          donationDollars = 0;
        } else {
          const n = parseFloat(v);
          if (!Number.isFinite(n) || n < 0) {
            checkoutMsg.textContent = errCheckoutInvalidDonation;
            return;
          }
          donationDollars = n;
        }
      }
      const donationNote = donationNoteInput ? String(donationNoteInput.value ?? '').trim() : '';
      if (donationNote.length > 500) {
        checkoutMsg.textContent = errCheckoutInvalidDonationNote;
        return;
      }
      const donationCategory = donationCategoryInput
        ? String(donationCategoryInput.value ?? '').trim() || 'environment'
        : 'environment';

      setCheckoutSubmitLoading(true);
      let membershipId = checkoutModalForm.getAttribute('data-membership-id')?.trim() ?? '';
      let leavingForCheckout = false;
      try {
        if (!membershipId) {
          if (!createForm) {
            checkoutMsg.textContent = errCheckoutGeneric;
            return;
          }
          const fd = new FormData(createForm);
          const tier = String(fd.get('tier') ?? '');
          const cre = await fetch('/api/membership/create-pending', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tier }),
          });
          const creData = await cre.json().catch(() => ({}));
          if (!cre.ok) {
            checkoutMsg.textContent =
              createErrorMessage(creData.error) || errCreateGeneric;
            return;
          }
          const newId = typeof creData.id === 'string' ? creData.id : '';
          if (!newId) {
            checkoutMsg.textContent = errCheckoutGeneric;
            return;
          }
          membershipId = newId;
          checkoutModalForm.setAttribute('data-membership-id', membershipId);
        }

        const res = await fetch('/api/membership/create-checkout-session', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            membershipId,
            donationDollars,
            donationNote,
            donationCategory,
            locale: memberLocale,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          if (data.error === 'invalid_donation') {
            checkoutMsg.textContent = errCheckoutInvalidDonation;
          } else if (data.error === 'invalid_donation_note') {
            checkoutMsg.textContent = errCheckoutInvalidDonationNote;
          } else if (data.error === 'invalid_donation_category') {
            checkoutMsg.textContent = errCheckoutInvalidDonationCategory;
          } else if (data.error === 'nothing_due') {
            checkoutMsg.textContent = errCheckoutNothingDue;
          } else if (data.error === 'no_lake_address' || data.error === 'voting_address_taken') {
            checkoutMsg.textContent = createErrorMessage(data.error);
          } else if (data.error === 'stripe_misconfigured') {
            checkoutMsg.textContent = errCheckoutStripeMisconfigured;
          } else {
            checkoutMsg.textContent = errCheckoutGeneric;
          }
          return;
        }
        if (typeof data.url === 'string' && data.url) {
          leavingForCheckout = true;
          window.location.assign(data.url);
          return;
        }
        checkoutMsg.textContent = errCheckoutGeneric;
      } catch {
        checkoutMsg.textContent = errNetwork;
      } finally {
        if (!leavingForCheckout) setCheckoutSubmitLoading(false);
      }
    });
  </script>
)}

<style>
