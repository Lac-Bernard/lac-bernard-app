  }

  .memberRecordsCardPrepaid {
    background: rgba(37, 99, 235, 0.05);
    border-color: rgba(37, 99, 235, 0.2);
  }

  .memberRecordsCardHistory {
    background: var(--panel2, rgba(0, 0, 0, 0.02));
    margin-top: 1.25rem;
  }

  .memberRecordsTitle {
    margin: 0 0 0.45rem;
    font-size: 1.12rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--text, rgba(0, 0, 0, 0.92));
  }

  .memberRecordsCardPrepaid .memberRecordsTitle {
    color: rgba(30, 64, 175, 0.98);
  }

  .memberRecordsLead {
    margin: 0 0 1rem;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--text, rgba(0, 0, 0, 0.88));
  }

  .memberRecordsLeadMuted {
    color: var(--muted, #555);
  }

  .memberRecordsTableScroll {
    overflow-x: auto;
    margin: 0 -0.15rem;
    padding: 0 0.15rem;
  }

  .memberRecordsTable {
