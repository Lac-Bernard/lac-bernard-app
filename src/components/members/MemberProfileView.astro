---
import MemberAppLayout from '../../layouts/MemberAppLayout.astro';
import MemberSessionHeroMeta from './MemberSessionHeroMeta.astro';
import { memberCopy, memberPaths, type MemberLocale } from '../../lib/members/i18n';
import type { MemberProfile } from '../../lib/members/memberLookup';

interface Props {
	locale: MemberLocale;
	mode: 'join' | 'edit';
	email: string;
	member: MemberProfile | null;
	nextUrl: string;
}

const { locale, mode, email, member, nextUrl } = Astro.props;
const t = memberCopy[locale];
const paths = memberPaths[locale];

const isEdit = mode === 'edit';
const title = isEdit ? t.profileEditTitle : t.profileJoinTitle;
const description = isEdit ? t.profileEditDescription : t.profileJoinDescription;
const heroTitle = isEdit ? t.profileEditHero : t.profileJoinHero;

const v = (s: string | null | undefined) => (s ?? '').trim();

const firstName = isEdit ? v(member?.first_name) : '';
const lastName = isEdit ? v(member?.last_name) : '';
const secondaryFirstName = isEdit ? v(member?.secondary_first_name) : '';
const secondaryLastName = isEdit ? v(member?.secondary_last_name) : '';
const secondaryEmail = isEdit ? v(member?.secondary_email) : '';
const primaryPhone = isEdit ? v(member?.primary_phone) : '';
const secondaryPhone = isEdit ? v(member?.secondary_phone) : '';
const lakeCivic = isEdit ? v(member?.lake_civic_number) : '';
const lakeStreet = isEdit ? v(member?.lake_street_name) : '';
const lakeSource = isEdit ? (member?.lake_address_source ?? null) : null;
const lakePlaceId = isEdit ? v(member?.lake_google_place_id) : '';
const lakeFormatted = isEdit ? v(member?.lake_formatted_address) : '';
const lakeLocale = locale === 'fr' ? 'fr' : 'en';
const addr = isEdit ? v(member?.primary_address) : '';
const city = isEdit ? v(member?.primary_city) : '';
const province = isEdit ? v(member?.primary_province) : '';
const country = isEdit ? v(member?.primary_country) : '';
const postal = isEdit ? v(member?.primary_postal_code) : '';
const emailOptIn = isEdit ? Boolean(member?.email_opt_in) : true;
const hasSecondaryContact = Boolean(secondaryFirstName || secondaryLastName || secondaryEmail || secondaryPhone);
/** Hide manual link in HTML until JS runs when a lake address already exists (avoids flash on edit). */
const hideLakeManualUntilHydrated = isEdit && Boolean(lakeCivic || lakeStreet);

const lakePlacesStrings = {
	manualLink: t.profileLakeManualLink,
	noSuggestions: t.profileLakeNoSuggestions,
	backToSearch: t.profileLakeBackToSearch,
	placesUnavailable: t.errorNetwork,
};

/** Passed to a separate module script so static `import` works (no `define:vars` in that script). */
const lakeProfileInitJson = JSON.stringify({
	locale: lakeLocale,
	strings: lakePlacesStrings,
	initialSource: lakeSource,
	initialPlaceId: lakePlaceId,
	initialFormatted: lakeFormatted,
	initialCivic: lakeCivic,
	initialStreet: lakeStreet,
});
---

<MemberAppLayout lang={locale} title={title} description={description} heroTitle={heroTitle}>
	<MemberSessionHeroMeta slot="hero-meta" locale={locale} email={email} signInRedirect={paths.signIn} />
	<section class="section">
		<div class="container narrow">
			{!isEdit && <p class="intro">{t.profileJoinIntro}</p>}

			<form id="member-profile-form" class="profileForm" novalidate aria-busy="false">
				<input type="hidden" name="nextUrl" value={nextUrl} />

				<fieldset class="profileFieldset">
					<legend class="profileLegend">{t.profileSectionContact}</legend>
					<p class="profileRequiredNote">{t.profileRequiredFieldsNote}</p>
					<div class="profileNamesGroup">
						<div class="profileField">
							<label class="fieldLabel" for="profile-email-readonly">{t.profileSignInEmail}</label>
							<input
								class="fieldInput fieldInputReadonly"
								id="profile-email-readonly"
								type="email"
								value={email}
								readonly
								tabindex={-1}
								aria-readonly="true"
							/>
						</div>

						<div class="profileField">
							<label class="fieldLabel fieldLabel--required" for="first_name">{t.profileFirstName}</label>
							<input
								class="fieldInput"
								id="first_name"
								name="first_name"
								type="text"
								autocomplete="given-name"
								required
								value={firstName}
							/>
						</div>

						<div class="profileField">
							<label class="fieldLabel fieldLabel--required" for="last_name">{t.profileLastName}</label>
							<input
								class="fieldInput"
								id="last_name"
								name="last_name"
								type="text"
								autocomplete="family-name"
								required
								value={lastName}
							/>
						</div>

						<div class="profileField">
							<label class="fieldLabel" for="primary_phone">
								{t.profilePrimaryPhone}
								<span class="fieldOptionalMark">{t.profileOptionalMark}</span>
							</label>
							<input class="fieldInput" id="primary_phone" name="primary_phone" type="text" autocomplete="tel" value={primaryPhone} />
						</div>
					</div>

					<div
						id="secondary-contact-group"
						class:list={[
							'profileNamesGroup',
							'profileSecondaryContactGroup',
							{ 'profileNamesGroup--collapsed': !hasSecondaryContact },
						]}
					>
						<label class="toggleLabel" for="show_secondary_contact">
							<input
								class="toggleInput"
								id="show_secondary_contact"
								name="show_secondary_contact"
								type="checkbox"
								checked={hasSecondaryContact ? true : undefined}
							/>
							<span>{t.profileShowSecondaryMember}</span>
						</label>
						<p class="fieldHelp">{t.profileSecondaryMemberHelp}</p>
						<div
							id="secondary-contact-fields"
							hidden={!hasSecondaryContact}
							aria-hidden={!hasSecondaryContact ? 'true' : 'false'}
							class:list={['secondaryFields', { 'secondaryFields--hidden': !hasSecondaryContact }]}
						>
							<div class="profileField">
								<label class="fieldLabel" for="secondary_first_name">{t.profileSecondaryFirstName}</label>
								<input
									class="fieldInput"
									id="secondary_first_name"
									name="secondary_first_name"
									type="text"
									autocomplete="off"
									value={secondaryFirstName}
								/>
							</div>

							<div class="profileField">
								<label class="fieldLabel" for="secondary_last_name">{t.profileSecondaryLastName}</label>
								<input
									class="fieldInput"
									id="secondary_last_name"
									name="secondary_last_name"
									type="text"
									autocomplete="off"
									value={secondaryLastName}
								/>
							</div>

							<div class="profileField">
								<label class="fieldLabel" for="secondary_email">{t.profileSecondaryEmail}</label>
								<input
									class="fieldInput"
									id="secondary_email"
									name="secondary_email"
									type="email"
									autocomplete="email"
									value={secondaryEmail}
								/>
							</div>

							<div class="profileField">
								<label class="fieldLabel" for="secondary_phone">{t.profileSecondaryPhone}</label>
								<input class="fieldInput" id="secondary_phone" name="secondary_phone" type="text" autocomplete="tel" value={secondaryPhone} />
							</div>
						</div>
					</div>
				</fieldset>

				<fieldset class="profileFieldset">
					<legend class="profileLegend">{t.profileSectionLake}</legend>
					<p class="fieldHelp">{t.profileLakeHelp}</p>

					<input type="hidden" name="lake_address_source" id="lake_address_source" value={lakeSource ?? ''} />
					<input type="hidden" name="lake_google_place_id" id="lake_google_place_id" value={lakePlaceId} />
					<input type="hidden" name="lake_formatted_address" id="lake_formatted_address" value={lakeFormatted} />
					<input type="hidden" name="lake_civic_number" id="lake_civic_number" value={lakeCivic} />
					<input type="hidden" name="lake_street_name" id="lake_street_name" value={lakeStreet} />

					<div id="lake-search-section" class="lakeAddressSearchSection">
						<div id="lake-address-combobox-block" class="lakeAddressComboboxBlock">
							<div class="profileField">
								<label class="fieldLabel" for="lake-address-search">
									{t.profileLakeSearchLabel}
									<span class="fieldOptionalMark">{t.profileOptionalMark}</span>
								</label>
								<div class="lakeAddressSearchWrap">
									<input
										class="fieldInput"
										id="lake-address-search"
										type="text"
										autocomplete="off"
										placeholder={t.profileLakeSearchPlaceholder}
										role="combobox"
										aria-autocomplete="list"
										aria-haspopup="listbox"
										aria-controls="lake-address-suggestions"
										aria-expanded="false"
									/>
									<ul
										id="lake-address-suggestions"
										class="lakeAddressSuggestList"
										hidden
										role="listbox"
										aria-label={t.profileLakeSearchLabel}
									>
									</ul>
								</div>
							</div>
						</div>
						<p id="lake-places-summary" class="lakeAddressSummary" hidden role="status" aria-live="polite"></p>
						<button type="button" class="lakeAddressTextBtn" id="lake-change-address" hidden>
							{t.profileLakeBackToSearch}
						</button>
						<button type="button" class="lakeAddressTextBtn" id="lake-manual-toggle" hidden={hideLakeManualUntilHydrated}>
							{t.profileLakeManualLink}
						</button>
					</div>

					<div id="lake-manual-section" class="lakeAddressManualSection profileNamesGroup" hidden>
						<div class="profileField">
							<label class="fieldLabel" for="lake_civic_visible">
								{t.profileLakeCivic}
								<span class="fieldOptionalMark">{t.profileOptionalMark}</span>
							</label>
							<input class="fieldInput" id="lake_civic_visible" type="text" autocomplete="off" value={lakeCivic} />
						</div>

						<div class="profileField">
							<label class="fieldLabel" for="lake_street_visible">
								{t.profileLakeStreet}
								<span class="fieldOptionalMark">{t.profileOptionalMark}</span>
							</label>
							<input class="fieldInput" id="lake_street_visible" type="text" autocomplete="off" value={lakeStreet} />
						</div>

						<button type="button" class="lakeAddressTextBtn" id="lake-back-search">
							{t.profileLakeBackToSearch}
						</button>
					</div>
				</fieldset>

				<label class="checkLabel profileEmailOptInCard">
					<input type="checkbox" name="email_opt_in" checked={emailOptIn ? true : undefined} class="checkInput" />
					<span class="checkLabelText">{t.profileEmailOptIn}</span>
				</label>

				<p id="profile-form-message" class="formMessage" role="status" aria-live="polite"></p>

				<div class="profileActions">
					<button type="submit" class="btnPrimary profileSubmit" id="profile-submit">
						<span class="profileSubmitSpinner" aria-hidden="true"></span>
						<span class="profileSubmitLabel">{isEdit ? t.profileSaveSubmit : t.profileCreateSubmit}</span>
					</button>{isEdit ? (
						<a class="btnGhost profileBack" href={paths.account}>{t.profileBackToAccount}</a>
					) : null}
				</div>
			</form>
		</div>
	</section>
</MemberAppLayout>

<script type="application/json" id="member-profile-lake-init" set:html={lakeProfileInitJson} />
<script>
	import { initLakeAddressPlacesUi } from '../../scripts/lake-address-places-ui';

	const raw = document.getElementById('member-profile-lake-init')?.textContent;
	if (raw) {
		const cfg = JSON.parse(raw) as {
			locale: 'en' | 'fr';
			strings: Record<string, string>;
			initialSource: string | null;
			initialPlaceId: string;
			initialFormatted: string;
			initialCivic: string;
			initialStreet: string;
		};

		const lakeSearch = document.getElementById('lake-address-search');
		const lakeSug = document.getElementById('lake-address-suggestions');
		const lakeSearchSection = document.getElementById('lake-search-section');
		const lakeManualSection = document.getElementById('lake-manual-section');
		const lakeSummary = document.getElementById('lake-places-summary');
		const lakeCivicH = document.getElementById('lake_civic_number');
		const lakeStreetH = document.getElementById('lake_street_name');
		const lakeSourceEl = document.getElementById('lake_address_source');
		const lakePlaceIdEl = document.getElementById('lake_google_place_id');
		const lakeFormattedEl = document.getElementById('lake_formatted_address');
		const lakeComboboxBlock = document.getElementById('lake-address-combobox-block');
		const lakeChangeAddressBtn = document.getElementById('lake-change-address');
		const lakeManualBtn = document.getElementById('lake-manual-toggle');
		const lakeBackBtn = document.getElementById('lake-back-search');
		const lakeCivicVis = document.getElementById('lake_civic_visible');
		const lakeStreetVis = document.getElementById('lake_street_visible');

		if (
			lakeSearch instanceof HTMLInputElement &&
			lakeSug instanceof HTMLUListElement &&
			lakeSearchSection instanceof HTMLElement &&
			lakeManualSection instanceof HTMLElement &&
			lakeCivicH instanceof HTMLInputElement &&
			lakeStreetH instanceof HTMLInputElement &&
			lakeSourceEl instanceof HTMLInputElement &&
			lakePlaceIdEl instanceof HTMLInputElement &&
			lakeFormattedEl instanceof HTMLInputElement &&
			lakeComboboxBlock instanceof HTMLElement &&
			lakeChangeAddressBtn instanceof HTMLButtonElement &&
			lakeManualBtn instanceof HTMLButtonElement &&
			lakeBackBtn instanceof HTMLButtonElement &&
			lakeCivicVis instanceof HTMLInputElement &&
			lakeStreetVis instanceof HTMLInputElement
		) {
			initLakeAddressPlacesUi({
				locale: cfg.locale,
				strings: cfg.strings,
				comboboxBlock: lakeComboboxBlock,
				changeAddressToggle: lakeChangeAddressBtn,
				searchInput: lakeSearch,
				suggestionsEl: lakeSug,
				searchSection: lakeSearchSection,
				manualSection: lakeManualSection,
				summaryEl: lakeSummary,
				civicHidden: lakeCivicH,
				streetHidden: lakeStreetH,
				sourceInput: lakeSourceEl,
				placeIdInput: lakePlaceIdEl,
				formattedInput: lakeFormattedEl,
				manualToggle: lakeManualBtn,
				backToggle: lakeBackBtn,
				civicVisible: lakeCivicVis,
				streetVisible: lakeStreetVis,
				initialSource: cfg.initialSource,
				initialPlaceId: cfg.initialPlaceId,
				initialFormatted: cfg.initialFormatted,
				initialCivic: cfg.initialCivic,
				initialStreet: cfg.initialStreet,
			});
		}
	}
</script>

<script
	define:vars={{
		mode,
		nextUrl,
		initialHasSecondaryContact: hasSecondaryContact,
		preservedPrimaryAddress: addr,
		preservedPrimaryCity: city,
		preservedPrimaryProvince: province,
		preservedPrimaryCountry: country,
		preservedPrimaryPostalCode: postal,
		errNetwork: t.errorNetwork,
		errFirstName: t.profileErrorFirstName,
		errLastName: t.profileErrorLastName,
		errSecondaryEmail: t.profileErrorSecondaryEmail,
		errSecondaryContact: t.profileErrorSecondaryContact,
		errPhone: t.profileErrorPhone,
		errLakeAddress: t.profileErrorLakeAddress,
		errPrimaryEmail: t.profileErrorPrimaryEmail,
		errAlreadyMember: t.profileErrorAlreadyMember,
		errSave: t.profileErrorSave,
		accountPath: paths.account,
	}}
>
	const form = document.getElementById('member-profile-form');
	const msg = document.getElementById('profile-form-message');
	const submitBtn = document.getElementById('profile-submit');
	const showSecondaryContact = document.getElementById('show_secondary_contact');
	const secondaryGroup = document.getElementById('secondary-contact-group');
	const secondaryFields = document.getElementById('secondary-contact-fields');

	if (showSecondaryContact) {
		showSecondaryContact.checked = Boolean(initialHasSecondaryContact);
	}

	function syncSecondaryFields() {
		if (!showSecondaryContact || !secondaryFields) return;
		const enabled = showSecondaryContact.checked;
		secondaryGroup?.classList.toggle('profileNamesGroup--collapsed', !enabled);
		secondaryFields.classList.toggle('secondaryFields--hidden', !enabled);
		secondaryFields.hidden = !enabled;
		secondaryFields.setAttribute('aria-hidden', enabled ? 'false' : 'true');
		secondaryFields.querySelectorAll('input').forEach((input) => {
			input.disabled = !enabled;
		});
		if (!enabled) {
			secondaryFields.querySelectorAll('input').forEach((input) => {
				input.value = '';
			});
		}
	}

	showSecondaryContact?.addEventListener('change', syncSecondaryFields);
	syncSecondaryFields();

	function trimOrNull(value) {
		if (typeof value !== 'string') return null;
		const trimmed = value.trim();
		return trimmed === '' ? null : trimmed;
	}

	function isValidEmail(value) {
		return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
	}

	function isPlausiblePhone(value) {
		const digits = value.replace(/[^\d]/g, '');
		return digits.length >= 10 && digits.length <= 15;
	}

	function validateBody(body) {
		if (!body.first_name) return errFirstName;
		if (!body.last_name) return errLastName;
		if (body.secondary_email && !isValidEmail(body.secondary_email)) return errSecondaryEmail;

		const phoneFields = [body.primary_phone, body.secondary_phone];
		if (phoneFields.some((value) => value && !isPlausiblePhone(value))) return errPhone;

		const hasLakeCivic = Boolean(trimOrNull(body.lake_civic_number));
		const hasLakeStreet = Boolean(trimOrNull(body.lake_street_name));
		if (hasLakeCivic !== hasLakeStreet) return errLakeAddress;

		if (showSecondaryContact?.checked) {
			const hasSecondaryValue = [
				body.secondary_first_name,
				body.secondary_last_name,
				body.secondary_email,
				body.secondary_phone,
			].some((value) => Boolean(trimOrNull(value)));
			if (!hasSecondaryValue) return errSecondaryContact;
		}

		return '';
	}

	function messageForApiError(error) {
		switch (error) {
			case 'first_name_required':
				return errFirstName;
			case 'last_name_required':
				return errLastName;
			case 'invalid_secondary_email':
				return errSecondaryEmail;
			case 'invalid_primary_email':
				return errPrimaryEmail;
			case 'invalid_primary_phone':
			case 'invalid_secondary_phone':
				return errPhone;
			case 'invalid_lake_address':
				return errLakeAddress;
			default:
				return errSave;
		}
	}

	function syncLakeManualToHidden() {
		const manualSec = document.getElementById('lake-manual-section');
		const cv = document.getElementById('lake_civic_visible');
		const sv = document.getElementById('lake_street_visible');
		const ch = document.getElementById('lake_civic_number');
		const sh = document.getElementById('lake_street_name');
		if (manualSec && !manualSec.hidden && cv instanceof HTMLInputElement && sv instanceof HTMLInputElement && ch && sh) {
			ch.value = cv.value.trim();
			sh.value = sv.value.trim();
		}
	}

	function payloadFromForm(fd) {
		return {
			first_name: String(fd.get('first_name') ?? '').trim(),
			secondary_first_name: fd.get('secondary_first_name') || null,
			last_name: String(fd.get('last_name') ?? '').trim(),
			secondary_last_name: fd.get('secondary_last_name') || null,
			secondary_email: fd.get('secondary_email') || null,
			primary_phone: fd.get('primary_phone') || null,
			secondary_phone: fd.get('secondary_phone') || null,
			lake_civic_number: fd.get('lake_civic_number') || null,
			lake_street_name: fd.get('lake_street_name') || null,
			lake_address_source: fd.get('lake_address_source') || null,
			lake_google_place_id: fd.get('lake_google_place_id') || null,
			lake_formatted_address: fd.get('lake_formatted_address') || null,
			primary_address: preservedPrimaryAddress || null,
			primary_city: preservedPrimaryCity || null,
			primary_province: preservedPrimaryProvince || null,
			primary_country: preservedPrimaryCountry || null,
			primary_postal_code: preservedPrimaryPostalCode || null,
			email_opt_in: fd.get('email_opt_in') === 'on',
		};
	}

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		if (!msg || !submitBtn) return;
		if (submitBtn.hasAttribute('disabled')) return;
		msg.textContent = '';
		form?.setAttribute('aria-busy', 'true');
		submitBtn.setAttribute('disabled', 'true');
		submitBtn.classList.add('is-loading');
		syncLakeManualToHidden();
		const fd = new FormData(form);
		const body = payloadFromForm(fd);
		const validationError = validateBody(body);
		if (validationError) {
			msg.textContent = validationError;
			form?.setAttribute('aria-busy', 'false');
			submitBtn.classList.remove('is-loading');
			submitBtn.removeAttribute('disabled');
			return;
		}
		try {
			const res = await fetch('/api/membership/profile', {
				method: mode === 'edit' ? 'PATCH' : 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(body),
			});
			const data = await res.json().catch(() => ({}));
			if (res.status === 409 && data.error === 'already_member') {
				msg.textContent = errAlreadyMember;
				window.setTimeout(() => {
					window.location.href = nextUrl || accountPath;
				}, 1200);
				return;
			}
			if (!res.ok) {
				msg.textContent = messageForApiError(data.error);
				return;
			}
			window.location.href = nextUrl || accountPath;
		} catch {
			msg.textContent = errNetwork;
		} finally {
			form?.setAttribute('aria-busy', 'false');
			submitBtn.classList.remove('is-loading');
			submitBtn.removeAttribute('disabled');
		}
	});
</script>

<style>
	.narrow {
		max-width: min(var(--member-column-max), 100%);
	}

	.intro {
		margin: 0 0 1.35rem;
		padding: 1.05rem 1.15rem;
		border: 1px solid rgba(15, 23, 42, 0.08);
		border-radius: 18px;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.99), rgba(248, 250, 252, 0.92));
		line-height: 1.6;
		color: var(--text, #334155);
		box-shadow:
			0 1px 2px rgba(15, 23, 42, 0.04),
			0 12px 32px rgba(15, 23, 42, 0.05);
		font-size: 0.96rem;
	}

	/*
	 * Avoid flex+gap on vertical stacks: whitespace text nodes between tags become flex items and
	 * read as extra space (often at card bottoms); block flow + margin on element siblings fixes it.
	 */
	.profileForm {
		display: block;
	}

	.profileForm > *:not(:first-child) {
		margin-top: 1.5rem;
	}

	.profileForm > input[type='hidden'] + .profileFieldset {
		margin-top: 0;
	}

	.profileFieldset {
		border: 1px solid rgba(15, 23, 42, 0.08);
		border-radius: 18px;
		padding: 1.35rem 1.35rem 1.4rem;
		margin: 0;
		display: block;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.99), rgba(248, 250, 252, 0.92));
		box-shadow:
			0 1px 2px rgba(15, 23, 42, 0.04),
			0 12px 32px rgba(15, 23, 42, 0.05);
	}

	.profileFieldset > *:not(:first-child) {
		margin-top: 0.9rem;
	}

	.profileNamesGroup {
		border: none;
		margin: 0;
		padding: 0;
		display: block;
	}

	/*
	 * One wrapper per label+control so spacing is between *fields*, not between label and input.
	 * Otherwise equal margin on alternating siblings makes labels look glued to the input above.
	 */
	.profileField {
		display: block;
		margin: 0;
	}

	.profileNamesGroup > .profileField:not(:first-child) {
		margin-top: 0.85rem;
	}

	.profileField .fieldLabel {
		display: block;
		margin: 0 0 0.4rem;
		line-height: 1.25;
	}

	.profileField .fieldInput {
		margin: 0;
	}

	.profileNamesGroup .profileLegend {
		padding: 0;
	}

	.profileLegend {
		font-weight: 700;
		font-size: 1rem;
		letter-spacing: -0.01em;
		padding: 0;
		color: var(--text, #0f172a);
	}

	.profileRequiredNote {
		margin: 0;
		font-size: 0.8rem;
		line-height: 1.45;
		color: var(--color-muted, #64748b);
		letter-spacing: 0.01em;
	}

	.fieldLabel {
		font-weight: 600;
		font-size: 0.82rem;
		letter-spacing: 0.01em;
