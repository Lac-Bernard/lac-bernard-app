---
import MemberAppLayout from '../../layouts/MemberAppLayout.astro';
import { memberCopy, safeMemberNext, type MemberLocale } from '../../lib/members/i18n';

interface Props {
	locale: MemberLocale;
}

const { locale } = Astro.props;
const t = memberCopy[locale];
const next = safeMemberNext(Astro.url.searchParams.get('next'), locale);
---

<MemberAppLayout
  lang={locale}
  title={t.signInTitle}
  description={t.signInDescription}
  heroTitle={t.signInHero}
  heroSubtitle={t.signInLead}
>
  <section class="section signInSection">
    <div class="container memberSignInColumn">
      <div class="signInCard">
        <form id="sign-in-form" class="signInForm" novalidate aria-busy="false">
          <input type="hidden" name="next" value={next} />
          <div class="signInField">
            <label class="fieldLabel" for="email">{t.emailLabel}</label>
            <input
              class="fieldInput"
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
              placeholder={t.emailPlaceholder}
              aria-describedby="sign-in-email-hint"
            />
            <p id="sign-in-email-hint" class="signInHint">
              {t.magicLinkFormExplainer}
            </p>
          </div>
          <p id="form-message" class="formMessage" role="status" aria-live="polite" hidden></p>
          <button type="submit" class="btnPrimary btnMagicSubmit" id="submit-btn">
            <span class="btnMagicSubmit-spinner" aria-hidden="true"></span>
            <span class="btnMagicSubmit-label">{t.sendMagicLink}</span>
          </button>
          <p id="try-another-wrap" class="tryAnotherWrap" hidden>
            <button type="button" class="tryAnotherBtn" id="try-another-btn">
              {t.signInTryAnotherEmail}
            </button>
          </p>
        </form>
        <p class="signInDivider" role="separator">
          <span class="signInDividerText">{t.signInDivider}</span>
        </p>
        <a
          class="btnGoogle btnGoogleSecondary"
          href={`/api/auth/sign-in-google?next=${encodeURIComponent(next)}`}
        >
          <svg class="btnGoogleIcon" width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
            <path
              fill="#EA4335"
              d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"
            ></path>
            <path
              fill="#4285F4"
              d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6C43.98 37.98 46.98 31.92 46.98 24.55z"
            ></path>
            <path
              fill="#FBBC05"
              d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"
            ></path>
            <path
              fill="#34A853"
              d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"
            ></path>
          </svg>
          {t.signInWithGoogle}
        </a>
      </div>
    </div>
  </section>
</MemberAppLayout>

<script
  define:vars={{
    next,
    errGeneric: t.errorGeneric,
    errNetwork: t.errorNetwork,
    checkEmail: t.checkEmail,
    sendingMagicLink: t.sendingMagicLink,
    sendMagicLink: t.sendMagicLink,
  }}
>
  const form = document.getElementById('sign-in-form');
  const messageEl = document.getElementById('form-message');
  const hintEl = document.getElementById('sign-in-email-hint');
  const submitBtn = document.getElementById('submit-btn');
  const emailInput = document.getElementById('email');
  const tryAnotherWrap = document.getElementById('try-another-wrap');
  const tryAnotherBtn = document.getElementById('try-another-btn');
  const labelEl = submitBtn?.querySelector('.btnMagicSubmit-label');
  let magicLinkJustSent = false;

  function setEmailHintVisible(visible) {
    if (!hintEl || !emailInput) return;
    hintEl.hidden = !visible;
    if (visible) {
      emailInput.setAttribute('aria-describedby', 'sign-in-email-hint');
    } else {
      emailInput.removeAttribute('aria-describedby');
    }
  }

  function resetMagicLinkIdle() {
    if (!tryAnotherWrap || !submitBtn || !labelEl) return;
    magicLinkJustSent = false;
    setEmailHintVisible(true);
    if (messageEl) {
      messageEl.textContent = '';
      messageEl.hidden = true;
      messageEl.classList.remove('formMessage--error');
    }
    tryAnotherWrap.hidden = true;
    submitBtn.removeAttribute('disabled');
    labelEl.textContent = sendMagicLink;
    submitBtn.classList.remove('is-loading');
  }

  function setMagicLinkLoading(loading) {
    if (!form || !submitBtn || !labelEl) return;
    form.setAttribute('aria-busy', loading ? 'true' : 'false');
    submitBtn.classList.toggle('is-loading', loading);
    submitBtn.toggleAttribute('disabled', loading);
    labelEl.textContent = loading ? sendingMagicLink : sendMagicLink;
  }

  emailInput?.addEventListener('input', () => {
    if (magicLinkJustSent) resetMagicLinkIdle();
  });

  tryAnotherBtn?.addEventListener('click', () => {
    if (!emailInput) return;
    resetMagicLinkIdle();
    emailInput.focus();
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!messageEl || !submitBtn || !emailInput || !tryAnotherWrap) return;

    const fd = new FormData(form);
    const email = String(fd.get('email') ?? '').trim();
    const n = String(fd.get('next') ?? next);

    tryAnotherWrap.hidden = true;
    messageEl.hidden = true;
    messageEl.textContent = '';
    messageEl.classList.remove('formMessage--error');
    setMagicLinkLoading(true);

    try {
      const res = await fetch('/api/auth/sign-in', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, next: n }),
      });
      const data = await res.json().catch(() => ({}));

      if (!res.ok) {
        setEmailHintVisible(true);
        messageEl.textContent = data.error || errGeneric;
        messageEl.hidden = false;
        messageEl.classList.add('formMessage--error');
        setMagicLinkLoading(false);
        return;
      }

      setEmailHintVisible(false);
      messageEl.textContent = checkEmail;
      messageEl.hidden = false;
      messageEl.classList.remove('formMessage--error');
      magicLinkJustSent = true;
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.classList.remove('is-loading');
      labelEl.textContent = sendMagicLink;
      form.setAttribute('aria-busy', 'false');
      tryAnotherWrap.hidden = false;
      submitBtn.blur();
    } catch {
      setEmailHintVisible(true);
      messageEl.textContent = errNetwork;
      messageEl.hidden = false;
      messageEl.classList.add('formMessage--error');
      setMagicLinkLoading(false);
    }
  });
</script>

<style>
  .signInSection {
    padding-bottom: 3.5rem;
  }

  /* Same horizontal measure as `.memberWorkspaceHeadInner` / `.memberHomeProse` */
  .memberSignInColumn {
    max-width: min(var(--member-column-max), 100%);
    margin-inline: auto;
  }

  .signInCard {
    padding: 2rem 1.75rem;
    border-radius: 14px;
    background: #fff;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }

  @media (min-width: 480px) {
    .signInCard {
      padding: 2.25rem 2rem;
    }
  }

  .btnGoogle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 12px 16px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: #fff;
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    box-sizing: border-box;
    transition: background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .btnGoogleIcon {
    flex-shrink: 0;
  }

  .btnGoogle:hover {
    background: rgba(0, 0, 0, 0.03);
    border-color: rgba(0, 0, 0, 0.18);
  }

  .btnGoogle:focus-visible {
    outline: 2px solid rgba(37, 99, 235, 0.45);
    outline-offset: 2px;
  }

  .btnGoogleSecondary {
    color: rgba(0, 0, 0, 0.78);
    background: rgba(0, 0, 0, 0.02);
  }

  .btnGoogleSecondary:hover {
    background: rgba(0, 0, 0, 0.05);
  }

  .signInDivider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 1.75rem 0 1.25rem;
  }

  .signInDivider::before,
  .signInDivider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .signInDividerText {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--muted);
    text-transform: lowercase;
  }

  /* Block stack avoids flex whitespace text nodes (same issue as profile / member home forms). */
  .signInForm {
    display: block;
  }

  .signInForm > *:not(:first-child) {
    margin-top: 12px;
  }

  .signInForm > input[type='hidden'] + * {
    margin-top: 0;
  }

  .signInField {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .signInField .fieldInput {
    margin-top: 0.15rem;
  }

  .fieldLabel {
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: 0.01em;
    color: var(--text);
  }

  .fieldInput {
    width: 100%;
    padding: 0.65rem 0.85rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    font-size: 1rem;
    line-height: 1.45;
    box-sizing: border-box;
    background: #fff;
    color: var(--text);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .fieldInput::placeholder {
    color: rgba(0, 0, 0, 0.38);
  }

  .fieldInput:hover {
    border-color: rgba(0, 0, 0, 0.22);
  }

  .fieldInput:focus {
    outline: none;
    border-color: rgba(37, 99, 235, 0.55);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  }

  .signInHint {
    margin: 0.15rem 0 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .formMessage {
    margin: 0.25rem 0 0;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .formMessage--error {
    color: #b91c1c;
  }

  .signInForm .btnPrimary {
    margin-top: 1.25rem;
    justify-content: center;
    width: 100%;
    border-radius: 10px;
    padding-top: 0.8rem;
    padding-bottom: 0.8rem;
  }

  /* After success: reads clearly as unavailable (global :hover no longer lifts it). */
  .signInForm .btnMagicSubmit:disabled:not(.is-loading) {
    opacity: 0.72;
  }

  .btnMagicSubmit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
  }

  .btnMagicSubmit-spinner {
    display: none;
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-top-color: currentColor;
    border-radius: 50%;
    box-sizing: border-box;
  }

  .btnMagicSubmit.is-loading .btnMagicSubmit-spinner {
    display: block;
    animation: magicLinkSpin 0.65s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .btnMagicSubmit.is-loading .btnMagicSubmit-spinner {
      animation: none;
      border-color: rgba(255, 255, 255, 0.5);
      border-top-color: rgba(255, 255, 255, 0.85);
    }
  }

  @keyframes magicLinkSpin {
    to {
      transform: rotate(360deg);
    }
  }

  .tryAnotherWrap {
    margin: 4px 0 0;
    text-align: center;
  }

  .tryAnotherBtn {
    margin: 0;
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    font-size: 0.9rem;
    color: var(--color-accent, #1a5f4a);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .tryAnotherBtn:hover {
    color: var(--color-accent-hover, #134a3a);
  }

  .tryAnotherBtn:focus-visible {
    outline: 2px solid var(--color-accent, #1a5f4a);
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>
