  @media (prefers-reduced-motion: reduce) {
    .adminPage :global(.adminBtn--submit.is-loading .adminBtnSpinner) {
      animation: none;
      border-color: rgba(255, 255, 255, 0.5);
      border-top-color: rgba(255, 255, 255, 0.85);
    }
  }

  @keyframes adminBtnSpin {
    to {
