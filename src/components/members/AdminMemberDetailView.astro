---
import '../../styles/admin-editorial.css';
import '../../styles/admin-member-pages.css';
import MemberAppLayout from '../../layouts/MemberAppLayout.astro';
import MemberSessionHeroMeta from './MemberSessionHeroMeta.astro';
import { memberCopy, memberPaths, type MemberLocale } from '../../lib/members/i18n';
import { mergeMemberUiStrings } from '../../lib/members/adminMemberUiCopy';
import { getMembershipCalendarYear } from '../../lib/members/membershipYear';

interface Props {
	locale: MemberLocale;
	email: string;
	memberId: string;
	/** SSR: member display name for `<title>` and workspace hero (matches identity strip). */
	memberPageTitle: string;
}

const { locale, email, memberId, memberPageTitle } = Astro.props;
const t = memberCopy[locale];
const paths = memberPaths[locale];
const calendarYear = getMembershipCalendarYear();
const numberLocale = locale === 'fr' ? 'fr-CA' : 'en-CA';

const adminKeys = [
	'adminDetailTitle',
	'adminDetailSectionMemberships',
	'adminDetailPaymentsHeading',
	'adminBreadcrumbAria',
	'adminMemberPageTitleLoading',
	'adminRecordPaymentBtn',
	'adminPaymentHeading',
	'adminAmountLabel',
	'adminMethodLabel',
	'adminMethodEtransfer',
	'adminMethodCheque',
	'adminMethodCash',
	'adminMethodUnknown',
	'adminMethodStripe',
	'adminDateLabel',
	'adminPaymentReferenceLabel',
	'adminNotesLabel',
	'adminSubmitPaymentBtn',
	'adminPromoteBtn',
	'adminPromoteSuccess',
	'adminPromoteNoAccount',
	'adminSaveMemberBtn',
	'adminLoading',
	'adminErrorGeneric',
	'adminMemberSaved',
	'adminPaymentSaved',
	'adminSecondaryEmailLabel',
	'adminSecondaryFirstNameLabel',
	'adminSecondaryLastNameLabel',
	'adminSecondaryPhoneLabel',
	'adminSecondaryContactHelp',
	'adminNotesFieldLabel',
	'adminStatusMemberLabel',
	'adminStatusMemberOptionNew',
	'adminStatusMemberOptionEnrolled',
	'adminStatusMemberOptionDisabled',
	'adminStatusMemberFieldTitle',
	'adminPromoteAdminTitle',
	'adminUserIdLabel',
	'adminPrimaryEmailLabel',
  'membershipTableYear',
  'membershipTableType',
  'membershipTableStatus',
	'membershipStatusActive',
	'membershipStatusPending',
	'adminTableAmount',
	'adminTableDuesPortion',
	'adminTableDonationPortion',
	'adminPaymentPreviewMembership',
	'adminPaymentPreviewDonation',
	'adminTablePaymentDate',
	'adminDetailNoMemberships',
	'adminDetailPaymentsEmpty',
	'adminDetailFutureBadge',
	'adminDetailMembershipYearPicker',
	'adminDetailStandardFee',
	'adminDetailAmountMembership',
	'adminDetailAmountDonation',
	'adminDetailAmountTotal',
	'adminDetailPaymentSummaryTitle',
	'adminDetailBalanceDue',
	'adminDetailDuesPaidInFull',
	'adminDeletePaymentBtn',
	'adminDeletePaymentConfirm',
	'adminPaymentDeleted',
	'adminTableActions',
	'adminDetailNoMembershipForYear',
	'adminDetailDonationNoteLabel',
	'adminTablePaymentRef',
	'adminAddMembershipOpen',
	'adminAddMembershipDialogTitle',
	'adminAddMembershipSubmit',
	'adminAddMemberInitialPending',
	'adminAddMemberInitialPaid',
	'adminAddMemberErrorNoLake',
	'adminAddMemberErrorAddressTaken',
	'adminAddMemberErrorDuplicateYear',
	'adminMembershipYearLabel',
	'checkoutModalCancel',
	'profileSectionPrimaryMember',
	'profileSectionSecondaryMember',
	'profileShowSecondaryMember',
	'profileSecondaryMemberHelp',
	'profileLakeHelp',
	'profileSecondaryEmail',
	'profileErrorFirstName',
	'profileErrorLastName',
	'profilePrimaryPhone',
	'profileSectionLake',
] as const;

const baseAdminStrings = Object.fromEntries(adminKeys.map((k) => [k, t[k as keyof typeof t]])) as Record<string, string>;
const adminStrings = mergeMemberUiStrings(locale, baseAdminStrings);

const tierLabels = { voting: t.tierGeneral, associate: t.tierAssociate };
const adminMembersTabHref = `${paths.admin}?tab=members`;
const editProfileUrl = `${paths.adminMembers}/${memberId}/edit`;
---

<MemberAppLayout
  lang={locale}
  title={memberPageTitle}
  description={t.adminDescription}
  heroTitle={memberPageTitle}
  alignHeroWithAdmin
>
  <nav slot="hero-breadcrumb" class="memberWorkspaceBreadcrumb" aria-label={t.adminBreadcrumbAria}>
    <div class="memberWorkspaceBreadcrumbList" role="list">
      <div role="listitem" class="memberWorkspaceBreadcrumbItem">
        <a href={paths.admin} class="memberWorkspaceBreadcrumbLink">{t.adminHero}</a>
      </div>
      <div role="listitem" class="memberWorkspaceBreadcrumbItem">
        <a href={adminMembersTabHref} class="memberWorkspaceBreadcrumbLink">{t.adminNavMembers}</a>
      </div>
    </div>
  </nav>
  <MemberSessionHeroMeta
    slot="hero-meta"
    locale={locale}
    email={email}
    signInRedirect={paths.signIn}
    variant="adminWorkspace"
  />
  <section class="section alt adminPage adminPageMemberDetail">
    <div class="container adminConsole adminMemberPageNarrow">
      <p class="adminDetailBack">
        <a href={adminMembersTabHref} class="adminDetailBackLink">{adminStrings.adminMemberDetailBack}</a>
      </p>
      <p id="admin-detail-status" class="adminStatus" aria-live="polite"></p>

      <div id="admin-detail-main"></div>
    </div>

    <dialog id="admin-payment-dialog" class="adminDialog adminPaymentDialogV2">
      <form id="admin-payment-form" class="adminPaymentForm" aria-busy="false">
        <h3 id="admin-payment-dialog-title">{adminStrings.adminRecordPaymentTitle}</h3>
        <p id="admin-payment-dialog-subtitle" class="adminPaymentDialogSub"></p>
        <input type="hidden" id="admin-payment-membership-id" value="" />
        <div class="adminMemberGrid2">
          <label>
            <span class="adminMemberFieldLabel">{t.adminAmountLabel}</span>
            <input id="admin-payment-amount" type="number" name="amount" min="0" step="0.01" required class="adminMemberInput" />
          </label>
          <label>
            <span class="adminMemberFieldLabel">{t.adminMethodLabel}</span>
            <select name="method" required class="adminMemberSelect">
              <option value="e-transfer">{t.adminMethodEtransfer}</option>
              <option value="cheque">{t.adminMethodCheque}</option>
              <option value="cash">{t.adminMethodCash}</option>
              <option value="other">{adminStrings.adminMethodOther}</option>
            </select>
          </label>
        </div>
        <div class="adminMemberGrid2">
          <label>
            <span class="adminMemberFieldLabel">{t.adminDateLabel}</span>
            <input type="date" name="date" class="adminMemberInput" />
          </label>
          <label>
            <span class="adminMemberFieldLabel">{adminStrings.adminDonationPortionLabel}</span>
            <input type="number" name="donation_portion" class="adminMemberInput" min="0" step="0.01" />
            <span class="adminMemberHint">{adminStrings.adminDonationPortionHint}</span>
          </label>
        </div>
        <label>
          <span class="adminMemberFieldLabel">{adminStrings.adminPaymentRefNotesLabel}</span>
          <input type="text" name="reference" class="adminMemberInput" autocomplete="off" maxlength="512" placeholder={adminStrings.adminPaymentRefNotesPlaceholder} />
        </label>
        <p id="admin-payment-split-preview" class="adminPaymentSplitPreview" hidden aria-live="polite"></p>
        <div class="adminDialogActions">
          <button type="submit" class="adminBtn adminBtn--solid adminBtn--submit" id="admin-payment-submit" value="default">
            <span class="adminBtnSpinner" aria-hidden="true"></span>
            <span class="adminBtnLabel">{t.adminSubmitPaymentBtn}</span>
          </button>
          <button type="button" class="adminBtn adminBtn--ghost" id="admin-payment-cancel">{t.checkoutModalCancel}</button>
        </div>
      </form>
    </dialog>

    <dialog id="admin-add-membership-dialog" class="adminDialog">
      <form id="admin-add-membership-form" class="adminPaymentForm" aria-busy="false">
        <h3>{adminStrings.adminModalAddMembershipTitle}</h3>
        <label>
          {t.adminMembershipYearLabel}
          <input
            type="number"
            name="year"
            min="2000"
            max="2100"
            step="1"
            required
            class="adminInput"
            id="admin-add-ms-year"
            value={calendarYear}
          />
        </label>
        <label>
          {t.membershipTableType}
          <select name="tier" required class="adminInput" id="admin-add-ms-tier">
            <option value="voting">{t.tierGeneral}</option>
            <option value="associate">{t.tierAssociate}</option>
          </select>
        </label>
        <div class="adminAddMsRadios" role="group" aria-label={t.membershipTableStatus}>
          <label class="adminRadioRow">
            <input type="radio" name="initial" value="pending" checked />
            {t.adminAddMemberInitialPending}
          </label>
          <label class="adminRadioRow">
            <input type="radio" name="initial" value="active_with_payment" />
            {t.adminAddMemberInitialPaid}
          </label>
        </div>
        <div id="admin-add-ms-paid" class="adminAddMsPaid" hidden>
          <div class="adminMemberGrid2">
            <label>
              <span class="adminMemberFieldLabel">{t.adminAmountLabel}</span>
              <input type="number" name="payment_amount" min="0" step="0.01" class="adminMemberInput" />
            </label>
            <label>
              <span class="adminMemberFieldLabel">{t.adminMethodLabel}</span>
              <select name="payment_method" class="adminMemberSelect">
                <option value="e-transfer">{t.adminMethodEtransfer}</option>
                <option value="cheque">{t.adminMethodCheque}</option>
                <option value="cash">{t.adminMethodCash}</option>
                <option value="other">{adminStrings.adminMethodOther}</option>
              </select>
            </label>
          </div>
          <div class="adminMemberGrid2">
            <label>
              <span class="adminMemberFieldLabel">{t.adminDateLabel}</span>
              <input type="date" name="payment_date" class="adminMemberInput" />
            </label>
            <label>
              <span class="adminMemberFieldLabel">{adminStrings.adminDonationPortionLabel}</span>
              <input type="number" name="payment_donation_portion" class="adminMemberInput" min="0" step="0.01" />
              <span class="adminMemberHint">{adminStrings.adminDonationPortionHint}</span>
            </label>
          </div>
          <label>
            <span class="adminMemberFieldLabel">{adminStrings.adminPaymentRefNotesLabel}</span>
            <input type="text" name="payment_reference" class="adminMemberInput" placeholder={adminStrings.adminPaymentRefNotesPlaceholder} />
          </label>
        </div>
        <div class="adminDialogActions">
          <button type="submit" class="adminBtn adminBtn--solid adminBtn--submit" id="admin-add-membership-submit">
            <span class="adminBtnSpinner" aria-hidden="true"></span>
            <span class="adminBtnLabel">{t.adminAddMembershipSubmit}</span>
          </button>
          <button type="button" class="adminBtn adminBtn--ghost" id="admin-add-membership-cancel">{t.checkoutModalCancel}</button>
        </div>
      </form>
    </dialog>
  </section>
</MemberAppLayout>

<script
  type="application/json"
  id="admin-member-detail-data"
  set:html={JSON.stringify({ adminStrings, tierLabels, memberId, calendarYear, numberLocale, editProfileUrl })}
></script>
<script>
  import { initAdminMemberDetailV2 } from '../../scripts/admin-member-detail-v2';
  const el = document.getElementById('admin-member-detail-data');
  const raw = el?.textContent;
  if (raw) {
    const { adminStrings, tierLabels, memberId, calendarYear, numberLocale, editProfileUrl } = JSON.parse(raw) as {
      adminStrings: Record<string, string>;
      tierLabels: { voting: string; associate: string };
      memberId: string;
      calendarYear: number;
      numberLocale: string;
      editProfileUrl: string;
    };
    initAdminMemberDetailV2(adminStrings, tierLabels, memberId, calendarYear, numberLocale, editProfileUrl);
  }
</script>

<style is:global>
  /* Client-rendered rows in #admin-detail-main must not rely on Astro-scoped attrs */
  .adminPageMemberDetail.adminPage {
    padding: 1.15rem 0 2.75rem;
  }
  .adminPageMemberDetail .adminDetailBack {
    margin: 0 0 1rem;
  }
  .adminPageMemberDetail .adminDetailBackLink {
    font-size: 13px;
    color: #888780;
    text-decoration: none;
  }
  .adminPageMemberDetail .adminDetailBackLink:hover {
    text-decoration: underline;
  }
  .adminPageMemberDetail .adminDetailIdentity {
    padding-bottom: 1.75rem;
    margin-bottom: 2rem;
    border-bottom: 0.5px solid var(--admin-border);
  }
  .adminPageMemberDetail .adminDetailIdentityTop {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-start;
  }
  .adminPageMemberDetail .adminDetailName {
    margin: 0;
    font-size: 24px;
    font-weight: 500;
  }
  .adminPageMemberDetail .adminDetailSince {
    margin: 0.35rem 0 0;
    font-size: 12px;
    color: #b4b2a9;
  }
  .adminPageMemberDetail .adminDetailDisabledBanner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.75rem;
    padding: 8px 12px;
    font-size: 12px;
    color: #854f0b;
    background: #faeeda;
    border-radius: 8px;
  }
  .adminPageMemberDetail .adminDetailFieldsRow {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    margin-top: 1.25rem;
  }
  .adminPageMemberDetail .adminDetailField {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 12rem;
  }
  .adminPageMemberDetail .adminDetailFieldLabel {
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #b4b2a9;
  }
  .adminPageMemberDetail .adminDetailEmailLink {
    color: #3a6b5a;
    text-decoration: none;
  }
  .adminPageMemberDetail .adminDetailEmailLink:hover {
    text-decoration: underline;
  }
  .adminPageMemberDetail .adminDetailMuted,
  .adminPageMemberDetail .adminDetailMutedSmall {
    color: #888780;
  }
  .adminPageMemberDetail .adminDetailMutedSmall {
    font-size: 11px;
  }
  .adminPageMemberDetail .adminDetailSection {
    margin-bottom: 2rem;
  }
  .adminPageMemberDetail .adminDetailMsCard {
    border: 0.5px solid var(--admin-border);
    border-radius: 12px;
    background: #fff;
    overflow: hidden;
  }
  .adminPageMemberDetail .adminDetailMsCard--dashed {
    border-style: dashed;
    padding: 1.25rem;
    text-align: center;
  }
  .adminPageMemberDetail   .adminDetailMsHead {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: #f1efe8;
    border-bottom: 0.5px solid var(--admin-border);
    font-weight: 500;
  }
  .adminPageMemberDetail .adminDetailMsHeadMain {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }
  .adminPageMemberDetail .adminDetailMsHeadYear {
    font-weight: 500;
  }
  .adminPageMemberDetail .adminDetailMsBody {
    padding: 1rem;
  }
  .adminPageMemberDetail .adminTierBadge {
    display: inline-block;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
  }
  .adminPageMemberDetail .adminTierBadge--voting {
    background: #e4ece4;
    color: #2d4a2d;
  }
  .adminPageMemberDetail .adminTierBadge--associate {
    background: #f1efe8;
    color: #888780;
    border: 0.5px solid #d3d1c7;
  }
  .adminPageMemberDetail   .adminPendingPill {
    display: inline-block;
    padding: 2px 9px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 500;
    background: #faeeda;
    color: #854f0b;
  }
  .adminPageMemberDetail .adminPendingPill--header {
    margin-left: auto;
  }
  .adminPageMemberDetail .adminDetailPayRow {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 0.75rem;
    align-items: start;
    padding: 0.65rem 0;
    border-bottom: 0.5px solid #f1efe8;
    transition: background 120ms;
  }
  .adminPageMemberDetail .adminDetailPayRow:hover {
    background: #f5f4f0;
  }
  .adminPageMemberDetail .adminDetailPayRow:last-child {
    border-bottom: none;
  }
  .adminPageMemberDetail .adminDetailPayAmt {
    font-weight: 500;
    text-align: right;
  }
  .adminPageMemberDetail .adminDetailPayDel {
    border: none;
    background: transparent;
    color: #d3d1c7;
    cursor: pointer;
    font-size: 1.1rem;
    line-height: 1;
    padding: 0.15rem 0.35rem;
    border-radius: 6px;
  }
  .adminPageMemberDetail .adminDetailPayDel:hover {
    color: #a32d2d;
    background: #fcebeb;
  }
  .adminPageMemberDetail .adminDetailPaySummary {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.35rem 1rem;
    align-items: baseline;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 0.5px solid var(--admin-border);
  }
  .adminPageMemberDetail .adminDetailFullBtn {
    width: 100%;
    margin-top: 1rem;
    justify-content: center;
  }
  .adminPageMemberDetail .adminDetailRowBtns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 1rem;
  }
  .adminPageMemberDetail .adminDetailAccordion {
    border: 0.5px solid var(--admin-border);
    border-radius: 12px;
    background: #fff;
    margin-bottom: 0.5rem;
  }
  .adminPageMemberDetail .adminDetailAccordionSum {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1rem;
    cursor: pointer;
    list-style: none;
  }
  .adminPageMemberDetail .adminDetailAccordionSum::-webkit-details-marker {
    display: none;
  }
  .adminPageMemberDetail .adminDetailChev {
    margin-left: auto;
    transition: transform 120ms;
    color: #888780;
  }
  .adminPageMemberDetail details[open] .adminDetailChev {
    transform: rotate(90deg);
  }
  .adminPageMemberDetail .adminDetailAccordionBody {
    padding: 0 1rem 1rem;
    border-top: 0.5px solid #f1efe8;
  }
  .adminPageMemberDetail .adminDetailPayRow--compact {
    grid-template-columns: 1fr 1fr auto;
    font-size: 13px;
  }
  .adminPageMemberDetail .adminDetailSection--admin {
    padding-top: 1.5rem;
    border-top: 0.5px solid var(--admin-border);
  }
  .adminPageMemberDetail .adminDetailAdminLabel {
    color: #d3d1c7;
  }
  .adminPageMemberDetail .adminDetailAdminBtns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0.5rem 0;
  }
  .adminPageMemberDetail .adminPaymentDialogSub {
    margin: 0 0 1rem;
    font-size: 13px;
    color: #888780;
  }
  .adminPageMemberDetail .adminDialog.adminPaymentDialogV2::backdrop {
    background: rgba(0, 0, 0, 0.25);
    backdrop-filter: none;
  }
  .adminPageMemberDetail .adminDialog.adminPaymentDialogV2 {
    background: #f9f8f6;
    border: 0.5px solid var(--admin-border);
    border-radius: 12px;
    max-width: min(480px, calc(100vw - 2rem));
  }
</style>
